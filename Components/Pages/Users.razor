@code {
    List<UserDto> allUsers = new();
    List<UserDto> filteredUsers = new();
    List<EntityItem> entities = new();
    bool isLoading = true, showModal = false, isEditing = false, isSaving = false, showToast = false;
    string toastMessage = "", toastType = "", modalError = "";
    UserForm form = new();

    // Filters
    string filterSearch = "", filterRole = "", filterEntity = "", filterStatus = "";

    // Pagination
    int pageNumber = 1, pageSize = 25;
    int[] pageSizeOptions = { 10, 25, 50, 100 };
    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredUsers.Count / pageSize));
    IEnumerable<UserDto> PagedUsers => filteredUsers.Skip((pageNumber - 1) * pageSize).Take(pageSize);

    // Import
    bool showImportModal = false, isImporting = false;
    string importError = "";
    List<ImportRow> importRows = new();

    static readonly Dictionary<string, int> RoleIds = new()
    {
        { "SuperAdmin", 1 }, { "Admin", 2 }, { "User", 3 }, { "Technician", 4 }
    };

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        if (!AuthService.HasPermission("CanManageUsers")) { Navigation.NavigateTo("/tickets"); return; }
        await Task.WhenAll(LoadUsers(), LoadEntities());
    }

    async Task LoadUsers()
    {
        isLoading = true;
        try
        {
            allUsers = await Http.CreateClient("API").GetFromJsonAsync<List<UserDto>>("api/users") ?? new();
            ApplyFilters();
        }
        catch (Exception ex) { ShowToast("Failed to load users: " + ex.Message, "error"); }
        finally { isLoading = false; }
    }

    async Task LoadEntities()
    {
        try { entities = await Http.CreateClient("API").GetFromJsonAsync<List<EntityItem>>("api/entity") ?? new(); }
        catch { entities = new(); }
    }

    void ApplyFilters()
    {
        var q = allUsers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterSearch))
        {
            var s = filterSearch.Trim().ToLower();
            q = q.Where(u =>
                (u.FirstName + " " + u.LastName).ToLower().Contains(s) ||
                u.Email.ToLower().Contains(s) ||
                (u.EmployeeCode ?? "").ToLower().Contains(s) ||
                (u.Username ?? "").ToLower().Contains(s));
        }

        if (!string.IsNullOrEmpty(filterRole))
            q = q.Where(u => u.Roles.Contains(filterRole));

        if (!string.IsNullOrEmpty(filterEntity) && int.TryParse(filterEntity, out var eid))
            q = q.Where(u => u.EntityId == eid);

        if (filterStatus == "active") q = q.Where(u => u.IsActive);
        else if (filterStatus == "inactive") q = q.Where(u => !u.IsActive);

        filteredUsers = q.ToList();
        pageNumber = 1;
    }

    void ClearFilters()
    {
        filterSearch = ""; filterRole = ""; filterEntity = ""; filterStatus = "";
        ApplyFilters();
    }

    void SetPageSize(int size) { pageSize = size; pageNumber = 1; }
    void FirstPage() => pageNumber = 1;
    void PrevPage() { if (pageNumber > 1) pageNumber--; }
    void NextPage() { if (pageNumber < TotalPages) pageNumber++; }
    void LastPage() => pageNumber = TotalPages;

    async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        importError = ""; importRows = new();
        var file = e.File;
        if (file == null) return;

        bool isCsv = file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase);
        bool isXlsx = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);

        if (!isCsv && !isXlsx)
        {
            importError = "Only CSV or XLSX files are supported.";
            showImportModal = true;
            return;
        }

        try
        {
            if (isCsv)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                var lines = new List<string>();
                while (!reader.EndOfStream)
                {
                    var line = await reader.ReadLineAsync();
                    if (line != null) lines.Add(line);
                }

                if (lines.Count < 2) { importError = "CSV must have a header row and at least one data row."; showImportModal = true; return; }

                // Normalize headers: remove spaces, lowercase
                var headers = lines[0].Split(',').Select(h => h.Trim().ToLower().Replace(" ", "")).ToArray();
                int Col(params string[] names)
                {
                    foreach (var n in names)
                    {
                        var idx = Array.IndexOf(headers, n.ToLower().Replace(" ", ""));
                        if (idx >= 0) return idx;
                    }
                    return -1;
                }

                int cEmpCode = Col("employeecode", "employecode", "empcode");
                int cName = Col("employeename", "employname", "name");
                int cFirst = Col("firstname");
                int cLast = Col("lastname");
                int cEmail = Col("email");
                int cPhone = Col("phone", "phonenumber");
                int cUsername = Col("username");
                int cEntity = Col("entityname", "entity");
                int cRole = Col("role");
                int cPass = Col("password");

                for (int i = 1; i < lines.Count; i++)
                {
                    if (string.IsNullOrWhiteSpace(lines[i])) continue;
                    var cols = lines[i].Split(',');
                    string Get(int idx) => idx >= 0 && idx < cols.Length ? cols[idx].Trim() : "";

                    string firstName = "", lastName = "";
                    if (cFirst >= 0 || cLast >= 0)
                    {
                        firstName = Get(cFirst);
                        lastName = Get(cLast);
                    }
                    else if (cName >= 0)
                    {
                        var parts = Get(cName).Split(' ', 2);
                        firstName = parts[0];
                        lastName = parts.Length > 1 ? parts[1] : "";
                    }

                    importRows.Add(ParseAndValidateRow(
                        Get(cEmpCode), firstName, lastName,
                        Get(cEmail), Get(cPhone), Get(cUsername),
                        Get(cEntity), Get(cRole), Get(cPass)));
                }
            }
            else // XLSX
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;

                var content = new MultipartFormDataContent();
                content.Add(new ByteArrayContent(ms.ToArray()), "file", file.Name);

                var client = Http.CreateClient("API");
                var response = await client.PostAsync("api/users/parse-xlsx", content);

                if (!response.IsSuccessStatusCode)
                {
                    importError = "Failed to parse XLSX file.";
                    showImportModal = true;
                    return;
                }

                var rows = await response.Content.ReadFromJsonAsync<List<XlsxRowDto>>();
                if (rows == null || rows.Count == 0)
                {
                    importError = "No data rows found in the XLSX file.";
                    showImportModal = true;
                    return;
                }

                foreach (var row in rows)
                {
                    string firstName = "", lastName = "";
                    if (!string.IsNullOrWhiteSpace(row.FirstName) || !string.IsNullOrWhiteSpace(row.LastName))
                    {
                        firstName = row.FirstName ?? "";
                        lastName = row.LastName ?? "";
                    }
                    else if (!string.IsNullOrWhiteSpace(row.EmployeeName))
                    {
                        var parts = row.EmployeeName.Split(' ', 2);
                        firstName = parts[0];
                        lastName = parts.Length > 1 ? parts[1] : "";
                    }

                    importRows.Add(ParseAndValidateRow(
                        row.EmployeeCode ?? "", firstName, lastName,
                        row.Email ?? "", row.Phone ?? "", row.Username ?? "",
                        row.EntityName ?? "", row.Role ?? "", row.Password ?? ""));
                }
            }

            showImportModal = true;
        }
        catch (Exception ex) { importError = "Parse error: " + ex.Message; showImportModal = true; }
    }

    ImportRow ParseAndValidateRow(string empCode, string firstName, string lastName,
        string email, string phone, string username, string entityName, string role, string password)
    {
        var row = new ImportRow
        {
            EmployeeCode = empCode,
            FirstName = firstName,
            LastName = lastName,
            Email = email,
            Phone = phone,
            Username = username,
            EntityName = entityName,
            Role = role,
            Password = password
        };

        if (string.IsNullOrWhiteSpace(row.Email)) row.Error = "Email required";
        else if (string.IsNullOrWhiteSpace(row.Username)) row.Error = "Username required";
        else if (string.IsNullOrWhiteSpace(row.Password) || row.Password.Length < 8) row.Error = "Password min 8 chars";
        else if (!string.IsNullOrWhiteSpace(row.Role) && !RoleIds.ContainsKey(row.Role)) row.Error = $"Invalid role '{row.Role}'";

        return row;
    }

    public class XlsxRowDto
    {
        public string? EmployeeCode { get; set; }
        public string? EmployeeName { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Username { get; set; }
        public string? EntityName { get; set; }
        public string? Role { get; set; }
        public string? Password { get; set; }
    }

    async Task RunImport()
    {
        isImporting = true;
        var client = Http.CreateClient("API");
        int ok = 0, fail = 0;

        foreach (var row in importRows.Where(r => r.Error == null && !r.Imported))
        {
            var entityId = entities.FirstOrDefault(e => e.Name.Equals(row.EntityName, StringComparison.OrdinalIgnoreCase))?.Id;
            var roleId = RoleIds.TryGetValue(row.Role ?? "User", out var rid) ? rid : 3;

            var dto = new
            {
                EmployeeCode = row.EmployeeCode,
                Username = row.Username,
                Email = row.Email,
                Password = row.Password,
                FirstName = row.FirstName,
                LastName = row.LastName,
                PhoneNumber = row.Phone,
                EntityId = (int?)entityId,
                RoleId = roleId
            };

            try
            {
                var response = await client.PostAsJsonAsync("api/users", dto);
                if (response.IsSuccessStatusCode) { row.Imported = true; ok++; }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    try { row.Error = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString(); }
                    catch { row.Error = $"HTTP {(int)response.StatusCode}"; }
                    fail++;
                }
            }
            catch (Exception ex) { row.Error = ex.Message; fail++; }

            StateHasChanged();
        }

        isImporting = false;
        ShowToast($"Import done: {ok} succeeded, {fail} failed", fail == 0 ? "success" : "error");
        if (ok > 0) await LoadUsers();
    }

    void CloseImportModal() { showImportModal = false; importError = ""; importRows = new(); }

    void OpenCreateModal() { isEditing = false; form = new() { RoleId = 3 }; modalError = ""; showModal = true; }

    void OpenEditModal(UserDto u)
    {
        isEditing = true;
        form = new()
        {
            Id = u.Id,
            EmployeeCode = u.EmployeeCode ?? "",
            Username = u.Username ?? "",
            FirstName = u.FirstName,
            LastName = u.LastName,
            Email = u.Email,
            PhoneNumber = u.PhoneNumber ?? "",
            EntityId = u.EntityId?.ToString() ?? ""
        };
        modalError = ""; showModal = true;
    }

    void CloseModal() { showModal = false; modalError = ""; }

    async Task SaveUser()
    {
        modalError = "";
        if (string.IsNullOrWhiteSpace(form.Email)) { modalError = "Email is required."; return; }
        if (string.IsNullOrWhiteSpace(form.Username)) { modalError = "Username is required."; return; }
        if (!isEditing && form.Password.Length < 8) { modalError = "Password must be at least 8 characters."; return; }

        isSaving = true;
        try
        {
            var client = Http.CreateClient("API");
            int? entityId = int.TryParse(form.EntityId, out var eid) ? eid : null;
            HttpResponseMessage response;

            if (isEditing)
            {
                var dto = new { form.EmployeeCode, form.Username, form.Email, form.FirstName, form.LastName, form.PhoneNumber, EntityId = entityId, NewPassword = string.IsNullOrWhiteSpace(form.Password) ? null : form.Password };
                response = await client.PutAsJsonAsync($"api/users/{form.Id}", dto);
            }
            else
            {
                var dto = new { form.EmployeeCode, form.Username, form.Email, form.Password, form.FirstName, form.LastName, form.PhoneNumber, EntityId = entityId, form.RoleId };
                response = await client.PostAsJsonAsync("api/users", dto);
            }

            if (response.IsSuccessStatusCode) { ShowToast(isEditing ? "User updated" : "User created", "success"); CloseModal(); await LoadUsers(); }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                string msg = "Failed to save user";
                try { msg = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? msg; } catch { }
                modalError = msg;
            }
        }
        catch (Exception ex) { modalError = "Error: " + ex.Message; }
        finally { isSaving = false; }
    }

    async Task ChangeRole(UserDto user, string? newRole)
    {
        if (string.IsNullOrEmpty(newRole) || !RoleIds.ContainsKey(newRole)) return;
        var content = new StringContent(System.Text.Json.JsonSerializer.Serialize(new { RoleId = RoleIds[newRole] }), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.CreateClient("API").PatchAsync($"api/users/{user.Id}/role", content);
        if (response.IsSuccessStatusCode) { ShowToast($"Role updated to {newRole}", "success"); await LoadUsers(); }
        else ShowToast("Failed to update role", "error");
    }

    async Task ChangeEntity(UserDto user, string? entityIdStr)
    {
        int? entityId = int.TryParse(entityIdStr, out var eid) ? eid : null;
        var dto = new { user.EmployeeCode, user.Username, user.Email, user.FirstName, user.LastName, user.PhoneNumber, EntityId = entityId, NewPassword = (string?)null };
        var response = await Http.CreateClient("API").PutAsJsonAsync($"api/users/{user.Id}", dto);
        if (response.IsSuccessStatusCode)
        {
            var u = allUsers.First(x => x.Id == user.Id);
            u.EntityId = entityId;
            u.EntityName = entities.FirstOrDefault(e => e.Id == entityId)?.Name;
            ApplyFilters(); ShowToast("Entity updated", "success"); StateHasChanged();
        }
        else ShowToast("Failed to update entity", "error");
    }

    async Task ToggleStatus(UserDto user)
    {
        var newStatus = !user.IsActive;
        var content = new StringContent(System.Text.Json.JsonSerializer.Serialize(new { IsActive = newStatus }), System.Text.Encoding.UTF8, "application/json");
        var response = await Http.CreateClient("API").PatchAsync($"api/users/{user.Id}/status", content);
        if (response.IsSuccessStatusCode) { user.IsActive = newStatus; ApplyFilters(); ShowToast(newStatus ? "User activated" : "User deactivated", "success"); StateHasChanged(); }
        else ShowToast("Failed to update status", "error");
    }

    async Task DeleteUser(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this user? This cannot be undone.");
        if (!confirmed) return;
        var response = await Http.CreateClient("API").DeleteAsync($"api/users/{id}");
        if (response.IsSuccessStatusCode) { ShowToast("User deleted", "success"); await LoadUsers(); }
        else ShowToast("Failed to delete user", "error");
    }

    string GetInitials(string first, string last)
        => ((string.IsNullOrEmpty(first) ? "" : first[0].ToString()) +
            (string.IsNullOrEmpty(last) ? "" : last[0].ToString())).ToUpper();

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    public class UserDto
    {
        public int Id { get; set; }
        public string EmployeeCode { get; set; } = "";
        public string Username { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string? PhoneNumber { get; set; }
        public int? EntityId { get; set; }
        public string? EntityName { get; set; }
        public bool IsActive { get; set; }
        public List<string> Roles { get; set; } = new();
    }

    public class UserForm
    {
        public int Id { get; set; }
        public string EmployeeCode { get; set; } = "";
        public string Username { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Password { get; set; } = "";
        public string EntityId { get; set; } = "";
        public int RoleId { get; set; } = 3;
    }

    public class EntityItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; }
    }

    public class ImportRow
    {
        public string EmployeeCode { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Username { get; set; } = "";
        public string EntityName { get; set; } = "";
        public string Role { get; set; } = "";
        public string Password { get; set; } = "";
        public string? Error { get; set; }
        public bool Imported { get; set; }
    }
