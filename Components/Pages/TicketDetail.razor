@page "/tickets/{TicketId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory Http
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using TicketingSystem.UI.Services
@implements IDisposable

<AppShell>
    <ChildContent>
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Loading ticket...</p>
            </div>
        }
        else if (ticket == null)
        {
            <div class="empty-state">
                <h5>Ticket not found</h5>
                <button class="btn btn-primary mt-3" @onclick="GoBack">Back to Tickets</button>
            </div>
        }
        else
        {
            <div class="detail-layout">

                <!-- LEFT: Main Content -->
                <div class="left-main">

                    <!-- Ticket Header -->
                    <div class="ticket-header-card">
                        <div class="ticket-header-top">
                            <div>
                                <span class="ticket-code">#@ticket.Id</span>
                                <h2 class="ticket-title">@ticket.Title</h2>
                            </div>
                            <span class="status-badge status-@ticket.Status.ToLower()">@FormatStatus(ticket.Status)</span>
                        </div>
                        <p class="ticket-desc">@ticket.Description</p>

                        @* Ticket-level attachments *@
                        @if (ticket.Attachments != null && ticket.Attachments.Count > 0)
                        {
                            <div class="ticket-attachments-row">
                                @foreach (var att in ticket.Attachments)
                                {
                                    @if (att.IsImage)
                                    {
                                        <div class="att-thumb" @onclick="() => OpenLightbox(apiBase + att.Url, att.FileName)" title="@att.FileName">
                                            <img src="@(apiBase + att.Url)" class="att-thumb-img" alt="@att.FileName" />
                                            <span class="att-thumb-name">@att.FileName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="@(apiBase + att.Url)" target="_blank" class="att-thumb att-file" title="@att.FileName">
                                            <span class="att-file-icon">
                                                @(att.FileName.EndsWith(".pdf") ? "📄" :
                                                  att.FileName.EndsWith(".doc") || att.FileName.EndsWith(".docx") ? "📝" :
                                                  att.FileName.EndsWith(".xls") || att.FileName.EndsWith(".xlsx") ? "📊" : "📎")
                                            </span>
                                            <span class="att-thumb-name">@att.FileName</span>
                                        </a>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <!-- Conversation -->
                    <div class="action-card">
                        <div class="action-header">
                            <span class="action-title">💬 Conversation</span>
                        </div>

                        @* CONVERSATION *@
                        <div class="conversation-area">
                            <div class="conversation-thread" id="chat-thread">
                                @if (comments.Count == 0)
                                {
                                    <div class="no-comments">No replies yet. Start the conversation below.</div>
                                }
                                else
                                {
                                    @foreach (var c in comments)
                                    {
                                        var isMe = c.UserId == AuthService.CurrentUser.Id;
                                        var isTech = c.UserId == ticket.AssignedToUserId;
                                        var isRequester = c.UserId == ticket.CreatedByUserId;
                                        var isLong = c.Message?.Length > 300;
                                        var isExpanded = expandedComments.Contains(c.Id);

                                        <div class="comment-bubble @(isMe ? "comment-mine" : "comment-other")">
                                            <div class="comment-meta">
                                                <span class="comment-author">
                                                    @c.UserName
                                                    @if (isTech)
                                                    {
                                                        <span class="role-tag tech-tag">Technician</span>
                                                    }
                                                    else if (isRequester)
                                                    {

                                                        <span class="role-tag req-tag">Requester</span>
                                                    }
                                                </span>
                                                <span class="comment-time">@c.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(c.Message))
                                            {
                                                <div class="comment-text">
                                                    @if (isLong && !isExpanded)
                                                    {
                                                        @c.Message[..300]
                                                        <span>... </span>
                                                        <button class="btn-view-more" @onclick="() => ToggleExpand(c.Id)">View more</button>
                                                    }
                                                    else if (isLong && isExpanded)
                                                    {
                                                        @c.Message
                                                        <button class="btn-view-more" @onclick="() => ToggleExpand(c.Id)"> View less</button>
                                                    }
                                                    else
                                                    {

                                                        @c.Message
                                                    }
                                                </div>
                                            }
                                            @if (c.Attachments != null && c.Attachments.Count > 0)
                                            {
                                                <div class="comment-attachments">
                                                    @foreach (var att in c.Attachments)
                                                    {
                                                        @if (att.IsImage)
                                                        {
                                                            <img src="@(apiBase + att.Url)" class="attachment-img" alt="@att.FileName"
                                                                 @onclick="() => OpenLightbox(apiBase + att.Url, att.FileName)" title="Click to enlarge" />
                                                        }
                                                        else
                                                        {
                                                            <a href="@(apiBase + att.Url)" target="_blank" class="attachment-file">
                                                                @(att.FileName.EndsWith(".pdf") ? "📄" :
                                                                  att.FileName.EndsWith(".doc") || att.FileName.EndsWith(".docx") ? "📝" :
                                                                  att.FileName.EndsWith(".xls") || att.FileName.EndsWith(".xlsx") ? "📊" : "📎")
                                                                @att.FileName
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            @if (ticket.Status == "Closed")
                            {
                                <div class="reply-closed">🔒 Ticket is closed — reopen it to continue the conversation.</div>
                            }
                            else if (CanReply())
                            {
                                <div class="reply-box">
                                    <textarea id="reply-textarea" class="reply-input"
                                              placeholder="Post a comment..."
                                              rows="3" value="@newComment"
                                              @oninput="e => newComment = e.Value?.ToString() ?? string.Empty"
                                              @onkeydown="HandleReplyKeyDown"></textarea>
                                    <div class="reply-footer">
                                        <button class="btn-attach-inline" @onclick="TriggerFileUpload" title="Attach file">📎 Attach</button>
                                        <button class="btn-save" @onclick="SendComment" disabled="@isSending">
                                            @(isSending ? "Saving..." : "Save")
                                        </button>
                                    </div>
                                    @if (pendingAttachments.Count > 0)
                                    {
                                        <div class="pending-attachments">
                                            @foreach (var att in pendingAttachments)
                                            {
                                                <div class="pending-item">
                                                    @if (att.IsImage)
                                                    {
                                                        <img src="@att.PreviewUrl" class="pending-img" />
                                                    }
                                                    else
                                                    {
                                                        <div class="pending-file">
                                                            <span class="pending-file-icon">
                                                                @(att.FileName.EndsWith(".pdf") ? "📄" :
                                                                  att.FileName.EndsWith(".doc") || att.FileName.EndsWith(".docx") ? "📝" :
                                                                  att.FileName.EndsWith(".xls") || att.FileName.EndsWith(".xlsx") ? "📊" : "📎")
                                                            </span>
                                                            <span>@(att.FileName.Length > 10 ? att.FileName[..10] + "…" : att.FileName)</span>
                                                        </div>
                                                    }
                                                    <button class="btn-remove-att" @onclick="() => RemovePending(att)">✕</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="reply-closed">You don't have permission to reply to this ticket.</div>
                            }
                        </div>

                    </div>
                </div>

                <!-- RIGHT: Metadata Panel -->
                <div class="right-meta">
                    <div class="meta-header">
                        <span class="meta-title">Request</span>
                        <button class="btn-back-sm" @onclick="GoBack">← Back</button>
                    </div>

                    <div class="meta-body">
                        <div class="meta-row">
                            <span class="meta-label">Ticket Number</span>
                            <span class="meta-value">#@ticket.Id</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Title</span>
                            <span class="meta-value">@ticket.Title</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Category</span>
                            <span class="meta-value">@(ticket.CategoryName ?? "—")</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Priority</span>
                            <span class="priority-badge priority-@ticket.Priority.ToLower()">@ticket.Priority</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Status</span>
                            <span class="status-badge status-@ticket.Status.ToLower()">@FormatStatus(ticket.Status)</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Requester</span>
                            <span class="meta-value">@(ticket.CreatedByName ?? "Unknown")</span>
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Technician</span>
                            @if (AuthService.HasPermission("CanAssignTicket"))
                            {
                                @if (ticket.Status == "Closed")
                                {
                                    <span class="meta-value">@(ticket.AssignedToName ?? "Unassigned") 🔒</span>
                                }
                                else
                                {
                                    <select class="meta-select" @bind="selectedTechnicianId" @bind:after="AssignTechnician">
                                        <option value="0">Unassigned</option>
                                        @foreach (var tech in technicians)
                                        {
                                            <option value="@tech.Id">@tech.FirstName @tech.LastName</option>
                                        }
                                    </select>
                                }
                            }
                            else
                            {
                                <span class="meta-value">@(ticket.AssignedToName ?? "Unassigned")</span>
                            }
                        </div>
                        <div class="meta-row">
                            <span class="meta-label">Created At</span>
                            <span class="meta-value">@ticket.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy h:mm tt")</span>
                        </div>
                        @if (ticket.UpdatedAt != null)
                        {
                            <div class="meta-row">
                                <span class="meta-label">Last Updated At</span>
                                <span class="meta-value">@ticket.UpdatedAt.Value.ToLocalTime().ToString("dd-MM-yyyy h:mm tt")</span>
                            </div>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="meta-actions">
                        @if (ticket.Status == "Closed")
                        {
                            <div class="closed-notice">🔒 This ticket is closed.</div>
                            @if (AuthService.HasPermission("CanReopenTicket"))
                            {
                                <button class="btn-meta btn-reopen-admin" @onclick="ReopenTicket">🔓 Reopen Ticket</button>
                            }
                            else if (ticket.CreatedByUserId == AuthService.CurrentUser.Id)
                            {
                                var closedAt = ticket.UpdatedAt ?? ticket.CreatedAt;
                                var hoursLeft = 48 - (DateTime.Now - closedAt.ToLocalTime()).TotalHours;
                                @if (hoursLeft > 0)
                                {
                                    <button class="btn-meta btn-reopen-requester" @onclick="ReopenAsRequester">
                                        🔓 Reopen <span class="reopen-timer">(@((int)hoursLeft)h left)</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="reopen-expired">⏰ Reopen window expired.</div>
                                }
                            }
                        }
                        else
                        {
                            @if (AuthService.HasPermission("CanEditTicket"))
                            {
                                <button class="btn-meta btn-edit" @onclick="OpenEditModal">✏️ Edit</button>
                            }
                            @if (AuthService.HasPermission("CanCloseTicket"))
                            {
                                <button class="btn-meta btn-close-ticket" @onclick="CloseTicket">🔒 Close</button>
                            }
                        }
                        @if (AuthService.HasPermission("CanDeleteTicket"))
                        {
                            <button class="btn-meta btn-delete" @onclick="DeleteTicket">🗑️ Delete</button>
                        }
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</AppShell>

@if (showEditModal && ticket != null)
{
    <div class="modal-backdrop" @onclick="CloseEditModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>✏️ Edit Ticket</h5>
                <button class="modal-close" @onclick="CloseEditModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="editTitle" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="4" @bind="editDescription"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="editStatus">
                            <option value="Open">Open</option>
                            <option value="InProgress">In Progress</option>
                            @if (AuthService.HasPermission("CanCloseTicket"))
                            {
                                <option value="Closed">Closed</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Priority</label>
                        <select class="form-select" @bind="editPriority">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEdit">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-box toast-@toastType">@toastMessage</div>
}

@if (lightboxUrl != null)
{
    <div class="lightbox-backdrop" @onclick="CloseLightbox">
        <div class="lightbox-box" @onclick:stopPropagation="true">
            <div class="lightbox-header">
                <span class="lightbox-name">@lightboxName</span>
                <div class="lightbox-actions">
                    <a href="@lightboxUrl" download="@lightboxName" class="btn-download">⬇ Download</a>
                    <button class="btn-lightbox-close" @onclick="CloseLightbox">✕</button>
                </div>
            </div>
            <div class="lightbox-body">
                <img src="@lightboxUrl" class="lightbox-img" alt="@lightboxName" />
            </div>
        </div>
    </div>
}

<script>
    window.scrollToBottom = function(elementId) {
        const el = document.getElementById(elementId);
        if (el) el.scrollTop = el.scrollHeight;
    };
    window.attachmentHelpers = {
        openPicker: function(dotNetRef) {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.png,.jpg,.jpeg,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt';
            input.multiple = true;
            input.onchange = async function() {
                for (const file of input.files) await window.attachmentHelpers.uploadFile(file, dotNetRef);
            };
            input.click();
        },
        uploadFile: async function(file, dotNetRef) {
            if (file.size > 10 * 1024 * 1024) { await dotNetRef.invokeMethodAsync('OnAttachError', 'File too large. Max 10MB.'); return; }
            const formData = new FormData();
            formData.append('file', file);
            try {
                const res = await fetch('http://localhost:5027/api/attachments/upload', { method: 'POST', body: formData });
                const data = await res.json();
                if (res.ok) {
                    const previewUrl = data.isImage ? 'http://localhost:5027' + data.url : '';
                    await dotNetRef.invokeMethodAsync('OnAttachSuccess', data.fileName, data.url, data.isImage, previewUrl);
                } else { await dotNetRef.invokeMethodAsync('OnAttachError', data.message || 'Upload failed'); }
            } catch(e) { await dotNetRef.invokeMethodAsync('OnAttachError', 'Network error'); }
        },
        setupPaste: function(dotNetRef) {
            document.addEventListener('paste', async function(e) {
                const ta = document.getElementById('reply-textarea');
                if (!ta || document.activeElement !== ta) return;
                const items = e.clipboardData?.items;
                if (!items) return;
                for (const item of items) {
                    if (item.type.startsWith('image/')) {
                        e.preventDefault();
                        const file = item.getAsFile();
                        if (file) await window.attachmentHelpers.uploadFile(file, dotNetRef);
                    }
                }
            });
        }
    };
</script>

<style>
    .loading-state, .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #6b7280;
    }

    /* ── LAYOUT ── */
    .detail-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 1.5rem;
        align-items: start;
        padding-top: 0;
    }

    .left-main, .right-meta {
        margin-top: 0;
    }

    @@media (max-width: 900px) {
        .detail-layout {
            grid-template-columns: 1fr;
        }
    }

    /* ── LEFT MAIN ── */
    .left-main {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* ── TICKET HEADER CARD ── */
    .ticket-header-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }

    .ticket-header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.75rem;
        gap: 1rem;
    }

    .ticket-code {
        color: #9ca3af;
        font-size: 0.8rem;
        font-weight: 600;
        display: block;
        margin-bottom: 0.25rem;
    }

    .ticket-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1e1b4b;
        margin: 0;
    }

    .ticket-desc {
        color: #4b5563;
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    /* Ticket-level attachment thumbnails */
    .ticket-attachments-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #f3f4f6;
    }

    .att-thumb {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        text-decoration: none;
        color: #374151;
        width: 80px;
    }

    .att-thumb-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        border: 1.5px solid #e5e7eb;
        transition: border-color 0.15s;
    }

    .att-thumb:hover .att-thumb-img {
        border-color: #7c3aed;
    }

    .att-file {
        width: 80px;
        height: 80px;
        background: #f8f7ff;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        transition: border-color 0.15s;
    }

        .att-file:hover {
            border-color: #7c3aed;
        }

    .att-file-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .att-thumb-name {
        font-size: 0.65rem;
        color: #6b7280;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 80px;
    }

    /* ── ACTION CARD ── */
    .action-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .action-header {
        padding: 1rem 1.5rem 0;
    }

    .action-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1e1b4b;
    }

    .action-tabs {
        display: flex;
        border-bottom: 1px solid #e5e7eb;
        margin-top: 0.75rem;
        padding: 0 1.5rem;
        gap: 0;
    }

    .action-tab {
        padding: 0.65rem 1.25rem;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        font-size: 0.875rem;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        transition: all 0.2s;
        margin-bottom: -1px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .action-tab:hover {
            color: #4f46e5;
        }

    .tab-active {
        color: #4f46e5 !important;
        border-bottom-color: #4f46e5 !important;
    }

    .tab-badge {
        background: #4f46e5;
        color: white;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.4rem;
        border-radius: 20px;
    }

    /* ── CONVERSATION AREA ── */
    .conversation-area {
        display: flex;
        flex-direction: column;
    }

    .conversation-thread {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 300px;
        max-height: 500px;
        overflow-y: auto;
        scroll-behavior: smooth;
    }

        .conversation-thread::-webkit-scrollbar {
            width: 5px;
        }

        .conversation-thread::-webkit-scrollbar-track {
            background: transparent;
        }

        .conversation-thread::-webkit-scrollbar-thumb {
            background: rgba(124,58,237,0.2);
            border-radius: 10px;
        }

            .conversation-thread::-webkit-scrollbar-thumb:hover {
                background: rgba(124,58,237,0.5);
            }

    .no-comments {
        text-align: center;
        color: #9ca3af;
        padding: 3rem 1rem;
        font-size: 0.875rem;
    }

    .comment-bubble {
        max-width: 75%;
        padding: 0.85rem 1.1rem;
        border-radius: 12px;
        animation: fadeIn 0.2s ease;
    }

    .comment-other {
        background: #f3f4f6;
        align-self: flex-start;
        border-bottom-left-radius: 4px;
    }

    .comment-mine {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 4px;
    }

    .comment-meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.3rem;
        font-size: 0.78rem;
    }

    .comment-other .comment-meta {
        color: #6b7280;
    }

    .comment-mine .comment-meta {
        color: rgba(255,255,255,0.8);
    }

    .comment-author {
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .comment-time {
        white-space: nowrap;
    }

    .comment-text {
        font-size: 0.9rem;
        line-height: 1.5;
        white-space: pre-wrap;
    }

    .role-tag {
        font-size: 0.65rem;
        padding: 0.1rem 0.4rem;
        border-radius: 8px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .tech-tag {
        background: #ddd6fe;
        color: #5b21b6;
    }

    .req-tag {
        background: #dbeafe;
        color: #1e40af;
    }

    .comment-mine .tech-tag, .comment-mine .req-tag {
        background: rgba(255,255,255,0.25);
        color: white;
    }

    .btn-view-more {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0 0.25rem;
        text-decoration: underline;
        margin-left: 0.25rem;
