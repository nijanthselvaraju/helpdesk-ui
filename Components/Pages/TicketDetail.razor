@code {
    [Parameter] public int TicketId { get; set; }

    TicketDetailDto? ticket;
    List<CommentDto> comments = new();
    List<UserDto> technicians = new();
    string newComment = "";
    bool isLoading = true, isSending = false, showToast = false, showEditModal = false;
    string toastMessage = "", toastType = "";
    int selectedTechnicianId = 0;
    string activeTab = "conversation";
    string apiBase = "http://localhost:5027";
    System.Threading.Timer? _pollTimer;
    int _lastCommentCount = 0;
    DotNetObjectReference<TicketDetail>? _dotNetRef;
    List<PendingAttachment> pendingAttachments = new();
    HashSet<int> expandedComments = new();
    string? lightboxUrl, lightboxName;
    string editTitle = "", editDescription = "", editStatus = "", editPriority = "";

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }

        var ticketTask = LoadTicket();
        var commentsTask = LoadComments();

        if (AuthService.HasPermission("CanAssignTicket"))
            await Task.WhenAll(ticketTask, commentsTask, LoadTechnicians());
        else
            await Task.WhenAll(ticketTask, commentsTask);

        isLoading = false;
        _lastCommentCount = comments.Count;
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                var client = Http.CreateClient("API");
                var result = await client.GetFromJsonAsync<List<CommentDto>>($"api/ticket/{TicketId}/comments");
                var updated = result ?? new();
                if (updated.Count != _lastCommentCount)
                {
                    comments = updated; _lastCommentCount = updated.Count;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("attachmentHelpers.setupPaste", _dotNetRef);
        }
        await JS.InvokeVoidAsync("scrollToBottom", "chat-thread");
    }

    async Task LoadTicket()
    {
        var client = Http.CreateClient("API");
        ticket = await client.GetFromJsonAsync<TicketDetailDto>($"api/ticket/{TicketId}");
        selectedTechnicianId = ticket?.AssignedToUserId ?? 0;
    }

    async Task LoadComments()
    {
        var client = Http.CreateClient("API");
        var result = await client.GetFromJsonAsync<List<CommentDto>>($"api/ticket/{TicketId}/comments");
        comments = result ?? new();
    }

    async Task LoadTechnicians()
    {
        try
        {
            var client = Http.CreateClient("API");
            var result = await client.GetFromJsonAsync<List<UserDto>>("api/users/technicians");
            technicians = result ?? new();
        }
        catch { technicians = new(); }
    }

    bool CanReply()
    {
        if (ticket == null || ticket.Status == "Closed") return false;
        if (!AuthService.HasPermission("CanCommentTicket")) return false;
        if (AuthService.HasRole("Admin") || AuthService.HasRole("SuperAdmin")) return true;
        var userId = AuthService.CurrentUser.Id;
        return ticket.CreatedByUserId == userId || ticket.AssignedToUserId == userId;
    }

    async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            if (!string.IsNullOrWhiteSpace(newComment) || pendingAttachments.Count > 0)
                await SendComment();
    }

    async Task TriggerFileUpload()
    {
        if (_dotNetRef == null) _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("attachmentHelpers.openPicker", _dotNetRef);
    }

    [JSInvokable]
    public Task OnAttachSuccess(string fileName, string url, bool isImage, string previewUrl)
    {
        pendingAttachments.Add(new PendingAttachment { FileName = fileName, Url = url, IsImage = isImage, PreviewUrl = previewUrl });
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnAttachError(string message) { ShowToast(message, "error"); return InvokeAsync(StateHasChanged); }

    void RemovePending(PendingAttachment att) => pendingAttachments.Remove(att);

    void ToggleExpand(int id)
    {
        if (expandedComments.Contains(id)) expandedComments.Remove(id);
        else expandedComments.Add(id);
    }

    async Task SendComment()
    {
        if (string.IsNullOrWhiteSpace(newComment) && pendingAttachments.Count == 0) return;
        if (ticket?.Status == "Closed") { ShowToast("Cannot reply to a closed ticket", "error"); return; }
        isSending = true;
        var client = Http.CreateClient("API");
        var dto = new { UserId = AuthService.CurrentUser.Id, Message = newComment.Trim(), Attachments = pendingAttachments.Select(a => new { a.FileName, a.Url, a.IsImage }).ToList() };
        var response = await client.PostAsJsonAsync($"api/ticket/{TicketId}/comments", dto);
        if (response.IsSuccessStatusCode)
        {
            comments.Add(new CommentDto { Id = 0, TicketId = TicketId, Message = newComment.Trim(), CreatedAt = DateTime.UtcNow, UserId = AuthService.CurrentUser.Id, UserName = AuthService.CurrentUser.Name, Attachments = pendingAttachments.Select(a => new AttachmentDto { FileName = a.FileName, Url = a.Url, IsImage = a.IsImage }).ToList() });
            newComment = ""; pendingAttachments.Clear();
            _ = Task.Run(async () => { await Task.Delay(500); await LoadComments(); await InvokeAsync(StateHasChanged); });
        }
        else ShowToast("Failed to send reply", "error");
        isSending = false;
    }

    void OpenEditModal()
    {
        if (ticket == null) return;
        editTitle = ticket.Title; editDescription = ticket.Description;
        editStatus = ticket.Status; editPriority = ticket.Priority;
        showEditModal = true;
    }

    void CloseEditModal() => showEditModal = false;

    async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(editTitle) || string.IsNullOrWhiteSpace(editDescription))
        { ShowToast("Title and description are required", "error"); return; }
        var client = Http.CreateClient("API");
        var response = await client.PutAsJsonAsync($"api/ticket/{TicketId}", new { Title = editTitle, Description = editDescription, Status = editStatus, Priority = editPriority });
        if (response.IsSuccessStatusCode) { ShowToast("Ticket updated ✏️", "success"); CloseEditModal(); await LoadTicket(); StateHasChanged(); }
        else ShowToast("Failed to update ticket", "error");
    }

    async Task CloseTicket()
    {
        if (ticket == null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Close this ticket?");
        if (!confirmed) return;
        try
        {
            var client = Http.CreateClient("API");
            var title = ticket.Title;
            var description = ticket.Description;
            var priority = ticket.Priority;
            var response = await client.PutAsJsonAsync($"api/ticket/{TicketId}", new { Title = title, Description = description, Status = "Closed", Priority = priority });
            if (response.IsSuccessStatusCode)
            {
                ticket.Status = "Closed";
                ticket.UpdatedAt = DateTime.Now;
                ShowToast("Ticket closed 🔒", "success");
                StateHasChanged();
            }
            else ShowToast("Failed to close ticket", "error");
        }
        catch (Exception ex)
        {
            ShowToast("Error: " + ex.Message, "error");
        }
    }

    async Task AssignTechnician()
    {
        var client = Http.CreateClient("API");
        await client.PatchAsJsonAsync($"api/ticket/{TicketId}/assign", new { TechnicianUserId = selectedTechnicianId });
        await LoadTicket(); StateHasChanged();
        ShowToast("Technician assigned ✅", "success");
    }

    async Task ReopenTicket()
    {
        var client = Http.CreateClient("API");
        var response = await client.PatchAsJsonAsync($"api/ticket/{TicketId}/reopen", new { IsRequester = false });
        if (response.IsSuccessStatusCode) { ShowToast("Ticket reopened ✅", "success"); await LoadTicket(); StateHasChanged(); }
        else ShowToast("Failed to reopen ticket", "error");
    }

    async Task ReopenAsRequester()
    {
        var client = Http.CreateClient("API");
        var response = await client.PatchAsJsonAsync($"api/ticket/{TicketId}/reopen", new { IsRequester = true });
        if (response.IsSuccessStatusCode) { ShowToast("Ticket reopened ✅", "success"); await LoadTicket(); StateHasChanged(); }
        else { var body = await response.Content.ReadAsStringAsync(); string msg = "Failed"; try { msg = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? msg; } catch { } ShowToast(msg, "error"); }
    }

    async Task DeleteTicket()
    {
        if (!AuthService.HasPermission("CanDeleteTicket")) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Permanently delete this ticket?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var response = await client.DeleteAsync($"api/ticket/{TicketId}");
        if (response.IsSuccessStatusCode) { ShowToast("Ticket deleted 🗑️", "success"); await Task.Delay(800); Navigation.NavigateTo("/tickets"); }
        else ShowToast("Failed to delete ticket", "error");
    }

    void OpenLightbox(string url, string name) { lightboxUrl = url; lightboxName = name; StateHasChanged(); }
    void CloseLightbox() { lightboxUrl = null; lightboxName = null; StateHasChanged(); }
    void GoBack() => Navigation.NavigateTo("/tickets");

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    string FormatStatus(string s) => s switch { "Open" => "Open", "InProgress" => "In Progress", "Closed" => "Closed", _ => s };
    public void Dispose() { _pollTimer?.Dispose(); _dotNetRef?.Dispose(); }

