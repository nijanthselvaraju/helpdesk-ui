@code {
    string search = "", status = "", priority = "";
    DateTime? dateFrom = null, dateTo = null;

    // Date picker state
    bool showDatePicker = false;
    DateTime leftMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime rightMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1);
    bool pickingStart = true; // first click = start, second = end

    void ToggleDatePicker() => showDatePicker = !showDatePicker;
    void CloseDatePicker() => showDatePicker = false;

    async Task DoneDatePicker()
    {
        showDatePicker = false;
        pageNumber = 1;
        await LoadTickets();
    }

    void ShiftLeft(int months)
    {
        leftMonth = leftMonth.AddMonths(months);
        if (leftMonth >= rightMonth) rightMonth = leftMonth.AddMonths(1);
    }

    void ShiftRight(int months)
    {
        rightMonth = rightMonth.AddMonths(months);
        if (rightMonth <= leftMonth) leftMonth = rightMonth.AddMonths(-1);
    }

    void SelectDay(DateTime day)
    {
        if (pickingStart)
        {
            dateFrom = day; dateTo = null; pickingStart = false;
        }
        else
        {
            if (day < dateFrom) { dateTo = dateFrom; dateFrom = day; }
            else dateTo = day;
            pickingStart = true;
        }
    }

    void ApplyPreset(string preset)
    {
        var today = DateTime.Today;
        switch (preset)
        {
            case "today": dateFrom = today; dateTo = today; break;
            case "yesterday": dateFrom = today.AddDays(-1); dateTo = today.AddDays(-1); break;
            case "thismonth": dateFrom = new DateTime(today.Year, today.Month, 1); dateTo = today; break;
            case "last30": dateFrom = today.AddDays(-29); dateTo = today; break;
            case "clear": dateFrom = null; dateTo = null; break;
        }
        pickingStart = true;
    }

    List<DateTime?> GetCalendarDays(DateTime month)
    {
        var days = new List<DateTime?>();
        var first = new DateTime(month.Year, month.Month, 1);
        int startDow = (int)first.DayOfWeek;
        for (int i = 0; i < startDow; i++) days.Add(null);
        int daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
        for (int d = 1; d <= daysInMonth; d++) days.Add(new DateTime(month.Year, month.Month, d));
        return days;
    }

    string GetDayClass(DateTime? day)
    {
        if (day == null) return "";
        var classes = new List<string>();
        if (day.Value.Date == DateTime.Today) classes.Add("day-today");
        if (dateFrom.HasValue && day.Value.Date == dateFrom.Value.Date) classes.Add("day-start");
        else if (dateTo.HasValue && day.Value.Date == dateTo.Value.Date) classes.Add("day-end");
        else if (dateFrom.HasValue && dateTo.HasValue && day.Value.Date > dateFrom.Value.Date && day.Value.Date < dateTo.Value.Date) classes.Add("day-in-range");
        return string.Join(" ", classes);
    }
    int pageNumber = 1, pageSize = 10, totalItems = 0;
    bool isLoading = false, showModal = false, showToast = false;
    string toastMessage = "", toastType = "";
    int openDropdownId = -1;
    double dropdownTop = 0, dropdownRight = 0;

    Ticket editTicket = new() { Status = "Open", Priority = "Low" };
    List<Ticket> tickets = new();

    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));
    bool IsFirstPage => pageNumber == 1;
    bool IsLastPage => pageNumber >= TotalPages;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        await LoadTickets();
    }

    async Task ApplyFilters() { pageNumber = 1; await LoadTickets(); }

    async Task ClearFilters()
    {
        search = ""; status = ""; priority = "";
        dateFrom = null; dateTo = null;
        pageNumber = 1;
        await LoadTickets();
    }

    void ViewTicket(int id) => Navigation.NavigateTo($"/tickets/{id}");

    async Task ToggleDropdown(int id)
    {
        if (openDropdownId == id) { CloseDropdown(); return; }
        openDropdownId = id;
        // Position dropdown near top-right of viewport
        var rect = await JSRuntime.InvokeAsync<BoundingRect>("eval",
            $"(function(){{var el=document.querySelectorAll('.btn-dots')[{tickets.FindIndex(t => t.Id == id)}]; var r=el.getBoundingClientRect(); return {{top:r.bottom,right:window.innerWidth-r.right}};}})()");
        dropdownTop = rect.Top;
        dropdownRight = rect.Right;
        StateHasChanged();
    }

    void CloseDropdown() { openDropdownId = -1; StateHasChanged(); }

    void OpenEditModal(Ticket ticket)
    {
        if (!AuthService.HasPermission("CanEditTicket")) { ShowToast("No permission to edit tickets", "error"); return; }
        editTicket = new Ticket { Id = ticket.Id, Title = ticket.Title, Description = ticket.Description, Status = ticket.Status, Priority = ticket.Priority };
        showModal = true;
    }

    void CloseModal() { showModal = false; editTicket = new Ticket { Status = "Open", Priority = "Low" }; }

    async Task SaveEditTicket()
    {
        if (string.IsNullOrWhiteSpace(editTicket.Title) || string.IsNullOrWhiteSpace(editTicket.Description))
        { ShowToast("Please fill in all required fields", "error"); return; }
        var client = Http.CreateClient("API");
        var response = await client.PutAsJsonAsync($"api/ticket/{editTicket.Id}", editTicket);
        if (response.IsSuccessStatusCode) { ShowToast("Ticket updated ✏️", "success"); CloseModal(); await LoadTickets(); }
        else { var body = await response.Content.ReadAsStringAsync(); string msg = "Failed to update ticket"; try { msg = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? msg; } catch { } ShowToast(msg, "error"); }
    }

    async Task LoadTickets()
    {
        isLoading = true; StateHasChanged();
        try
        {
            var client = Http.CreateClient("API");
            bool canViewAll = AuthService.HasPermission("CanViewAllTickets");
            var url = $"api/ticket?search={Uri.EscapeDataString(search)}&status={status}&priority={priority}&page={pageNumber}&pageSize={pageSize}";
            if (dateFrom.HasValue) url += $"&dateFrom={dateFrom.Value:yyyy-MM-dd}";
            if (dateTo.HasValue) url += $"&dateTo={dateTo.Value:yyyy-MM-dd}";
            if (canViewAll) url += "&viewAll=true";
            else url += $"&currentUserId={AuthService.CurrentUser.Id}&viewAll=false";
            var result = await client.GetFromJsonAsync<TicketResponse>(url);
            tickets = result?.Data ?? new();
            totalItems = result?.TotalItems ?? 0;
        }
        catch (Exception ex)
        {
            tickets = new();
            totalItems = 0;
            ShowToast("Failed to load tickets: " + ex.Message, "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    async Task DeleteTicket(int id)
    {
        if (!AuthService.HasPermission("CanDeleteTicket")) { ShowToast("No permission to delete tickets", "error"); return; }
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this ticket?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var response = await client.DeleteAsync($"api/ticket/{id}");
        if (response.IsSuccessStatusCode) { ShowToast("Ticket deleted 🗑️", "success"); await LoadTickets(); }
        else ShowToast("Failed to delete ticket", "error");
    }

    async Task CloseTicketFromList(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Close this ticket?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var t = tickets.FirstOrDefault(x => x.Id == id);
        if (t == null) return;
        var response = await client.PutAsJsonAsync($"api/ticket/{id}", new { t.Title, t.Description, Status = "Closed", Priority = t.Priority });
        if (response.IsSuccessStatusCode) { ShowToast("Ticket closed 🔒", "success"); await LoadTickets(); }
        else ShowToast("Failed to close ticket", "error");
    }

    async Task ReopenTicketFromList(int id)
    {
        var client = Http.CreateClient("API");
        var content = new StringContent(System.Text.Json.JsonSerializer.Serialize(new { IsRequester = false }), System.Text.Encoding.UTF8, "application/json");
        var response = await client.PatchAsync($"api/ticket/{id}/reopen", content);
        if (response.IsSuccessStatusCode) { ShowToast("Ticket reopened ✅", "success"); await LoadTickets(); }
        else ShowToast("Failed to reopen ticket", "error");
    }

    async Task NextPage() { pageNumber++; await LoadTickets(); }
    async Task PreviousPage() { if (pageNumber > 1) { pageNumber--; await LoadTickets(); } }

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    int GetDaysBetween(DateTime created, DateTime closed) => (int)Math.Ceiling((closed - created).TotalDays);

    string FormatStatus(string s) => s switch { "Open" => "Open", "InProgress" => "In Progress", "Closed" => "Closed", _ => s };

    public class TicketResponse
    {
        public int TotalItems { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public List<Ticket> Data { get; set; } = new();
    }

    public class BoundingRect
    {
        public double Top { get; set; }
        public double Right { get; set; }
    }
}
