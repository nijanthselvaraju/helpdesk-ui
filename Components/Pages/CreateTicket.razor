@page "/tickets/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory Http
@inject NavigationManager Nav
@inject AuthService AuthService
@inject IJSRuntime JS
@using TicketingSystem.UI.Models
@using TicketingSystem.UI.Services

<AppShell>
    <ChildContent>
        <div class="create-ticket-wrapper">
            <div class="create-ticket-header">
                <button class="btn-back" @onclick='() => Nav.NavigateTo("/tickets")'>
                    ← Back
                </button>
                <h4>New Ticket</h4>
            </div>

            <div class="create-ticket-card">

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <div class="field-group">
                    <label>TITLE <span class="required">*</span></label>
                    <input class="form-control" placeholder="Brief summary of the issue"
                           @bind="title" />
                </div>

                <div class="field-group">
                    <label>DESCRIPTION <span class="required">*</span></label>
                    <textarea class="form-control description-box"
                              placeholder="Describe the issue in detail..."
                              @bind="description"></textarea>
                </div>

                <div class="field-row">
                    <div class="field-group half">
                        <label>PRIORITY</label>
                        <select class="form-select" @bind="priority">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>

                    <div class="field-group half">
                        <label>CATEGORY <span class="required">*</span></label>
                        <select class="form-select" @bind="selectedCategoryId">
                            <option value="0">-- Select --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        @if (selectedCategoryId > 0)
                        {
                            var selectedCat = categories.FirstOrDefault(c => c.Id == selectedCategoryId);
                            if (selectedCat != null && selectedCat.ApprovalType != "NoApproval")
                            {
                                <div class="approval-hint">
                                    @if (selectedCat.ApprovalType == "BeforeWork")
                                    {
                                        <span>⏳ This request requires <strong>pre-approval</strong> before work begins.</span>
                                    }
                                    else
                                    {
                                        <span>✅ This ticket requires <strong>sign-off</strong> after work is completed.</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                @* Attachments *@
                <div class="field-group">
                    <label>ATTACHMENTS <span class="optional">(optional)</span></label>
                    <div class="attach-drop-zone" @onclick="TriggerFileUpload">
                        <span class="attach-icon">📎</span>
                        <span>Click to attach files</span>
                        <span class="attach-hint">Images, PDF, Word, Excel — max 10MB each</span>
                    </div>

                    @if (pendingAttachments.Count > 0)
                    {
                        <div class="pending-attachments">
                            @foreach (var att in pendingAttachments)
                            {
                                <div class="pending-item">
                                    @if (att.IsImage)
                                    {
                                        <img src="@att.PreviewUrl" class="pending-img"
                                             @onclick="() => OpenLightbox(att.PreviewUrl, att.FileName)" />
                                    }
                                    else
                                    {
                                        <div class="pending-file">
                                            <span class="pending-file-icon">
                                                @(att.FileName.EndsWith(".pdf") ? "📄" :
                                                  att.FileName.EndsWith(".doc") || att.FileName.EndsWith(".docx") ? "📝" :
                                                  att.FileName.EndsWith(".xls") || att.FileName.EndsWith(".xlsx") ? "📊" : "📎")
                                            </span>
                                            <span class="pending-file-name">@(att.FileName.Length > 12 ? att.FileName[..12] + "…" : att.FileName)</span>
                                        </div>
                                    }
                                    <button class="btn-remove-att" @onclick="() => pendingAttachments.Remove(att)">✕</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <button class="btn-submit" @onclick="HandleSubmit" disabled="@isSubmitting">
                    🎫 @(isSubmitting ? "Submitting..." : "Submit Ticket")
                </button>

            </div>
        </div>
    </ChildContent>
</AppShell>

@* Lightbox for image preview *@
@if (lightboxUrl != null)
{
    <div class="lightbox-backdrop" @onclick="CloseLightbox">
        <div class="lightbox-box" @onclick:stopPropagation="true">
            <div class="lightbox-header">
                <span class="lightbox-name">@lightboxName</span>
                <button class="btn-lightbox-close" @onclick="CloseLightbox">✕</button>
            </div>
            <div class="lightbox-body">
                <img src="@lightboxUrl" class="lightbox-img" alt="@lightboxName" />
            </div>
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-box toast-@toastType">@toastMessage</div>
}

<script>
    window.createTicketAttachments = {
        openPicker: function (dotNetRef) {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.png,.jpg,.jpeg,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt';
            input.multiple = true;
            input.onchange = async function () {
                for (const file of input.files) {
                    await window.createTicketAttachments.uploadFile(file, dotNetRef);
                }
            };
            input.click();
        },

        uploadFile: async function (file, dotNetRef) {
            if (file.size > 10 * 1024 * 1024) {
                await dotNetRef.invokeMethodAsync('OnAttachError', 'File too large. Max 10MB.');
                return;
            }
            const formData = new FormData();
            formData.append('file', file);
            try {
                const res = await fetch('http://localhost:5027/api/attachments/upload', {
                    method: 'POST', body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    const previewUrl = data.isImage ? 'http://localhost:5027' + data.url : '';
                    await dotNetRef.invokeMethodAsync('OnAttachSuccess',
                        data.fileName, data.url, data.isImage, previewUrl);
                } else {
                    await dotNetRef.invokeMethodAsync('OnAttachError', data.message || 'Upload failed');
                }
            } catch (e) {
                await dotNetRef.invokeMethodAsync('OnAttachError', 'Network error during upload');
            }
        }
    };
</script>

<style>
