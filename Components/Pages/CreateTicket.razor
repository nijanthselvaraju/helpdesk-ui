</style>

@code {
    private string title = "";
    private string description = "";
    private string priority = "Low";
    private int selectedCategoryId = 0;
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool showToast = false;
    private string toastMessage = "", toastType = "";
    private string? lightboxUrl, lightboxName;

    private List<CategoryOption> categories = new();
    private List<PendingAttachment> pendingAttachments = new();
    private DotNetObjectReference<CreateTicket>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadCategories();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
        }
        await Task.CompletedTask;
    }

    async Task LoadCategories()
    {
        try
        {
            var client = Http.CreateClient("API");
            // Load categories active for the current user's entity
            var entityId = AuthService.CurrentUser.EntityId;
            string url = entityId > 0 ? $"api/category/entity/{entityId}" : "api/category";
            var result = await client.GetFromJsonAsync<List<CategoryOption>>(url);
            categories = result ?? new();
        }
        catch { categories = new(); }
    }

    async Task TriggerFileUpload()
    {
        if (_dotNetRef == null) _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("createTicketAttachments.openPicker", _dotNetRef);
    }

    [JSInvokable]
    public Task OnAttachSuccess(string fileName, string url, bool isImage, string previewUrl)
    {
        pendingAttachments.Add(new PendingAttachment { FileName = fileName, Url = url, IsImage = isImage, PreviewUrl = previewUrl });
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnAttachError(string message)
    {
        ShowToast(message, "error");
        return InvokeAsync(StateHasChanged);
    }

    void OpenLightbox(string url, string name) { lightboxUrl = url; lightboxName = name; StateHasChanged(); }
    void CloseLightbox() { lightboxUrl = null; lightboxName = null; StateHasChanged(); }

    private async Task HandleSubmit()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(title)) { errorMessage = "Title is required."; return; }
        if (string.IsNullOrWhiteSpace(description)) { errorMessage = "Description is required."; return; }
        if (selectedCategoryId == 0) { errorMessage = "Please select a category."; return; }

        isSubmitting = true;
        try
        {
            var client = Http.CreateClient("API");

            // Send attachments inside the ticket DTO — stored as ticket-level attachments, not comments
            var createDto = new
            {
                Title = title,
                Description = description,
                Status = "Open",
                Priority = priority,
                CreatedByUserId = AuthService.CurrentUser.Id,
                CategoryId = selectedCategoryId,
                Attachments = pendingAttachments.Select(a => new { a.FileName, a.Url, a.IsImage }).ToList()
            };
            var response = await client.PostAsJsonAsync("api/ticket", createDto);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                string msg = "Failed to create ticket";
                try { msg = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? msg; }
                catch { }
                errorMessage = msg;
                return;
            }

            Nav.NavigateTo("/tickets");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to create ticket: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    public void Dispose() { _dotNetRef?.Dispose(); }

    public class CategoryOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string ApprovalType { get; set; } = "NoApproval";
    }

    public class PendingAttachment
    {
        public string FileName { get; set; } = "";
        public string Url { get; set; } = "";
        public bool IsImage { get; set; }
        public string PreviewUrl { get; set; } = "";
    }
}
