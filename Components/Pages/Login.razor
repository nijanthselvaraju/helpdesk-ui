@page "/login"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using TicketingSystem.UI.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Login – Helpdesk Ticket</PageTitle>

<div class="login-page">
    <div class="login-left">
        <div class="brand">
            <span class="brand-icon">🎫</span>
            <h2>Helpdesk Ticket</h2>
            <p>Manage your support tickets efficiently and effectively.</p>
        </div>
        <div class="features">
            <div class="feature-item">✅ Track tickets in real-time</div>
            <div class="feature-item">🔒 Custom team roles</div>
            <div class="feature-item">📊 Automate Priority Levels</div>
        </div>
    </div>

    <div class="login-right">
        <div class="login-card">
            <div class="login-header">
                <span class="login-icon">🎫</span>
                <h1>Welcome back</h1>
                <p>Sign in to your account</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error">
                    <span>⚠️ @errorMessage</span>
                    <button class="alert-close" @onclick="() => errorMessage = string.Empty">✕</button>
                </div>
            }

            <div class="form-group">
                <label for="email">Email Address</label>
                <div class="input-wrapper">
                    <span class="input-icon">✉️</span>
                    <input id="email"
                           type="email"
                           class="form-input"
                           placeholder="you@example.com"
                           value="@email"
                           @oninput="e => email = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="HandleKeyDown"
                           disabled="@isLoading" />
                </div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <input id="password"
                           type="@(showPassword ? "text" : "password")"
                           class="form-input"
                           placeholder="••••••••"
                           value="@password"
                           @oninput="e => password = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="HandleKeyDown"
                           disabled="@isLoading" />

                    <button type="button"
                            class="password-toggle"
                            @onclick="() => showPassword = !showPassword">
                        @(showPassword ? "👁️" : "👁️‍🗨️")
                    </button>
                </div>

                <div class="remember-me">
                    <input type="checkbox" id="remember" @bind="rememberMe" />
                    <label for="remember">Remember Me</label>
                </div>


            </div>

            <button class="btn-login" @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In →</span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .login-page {
        min-height: 100vh;
        display: flex;
    }

    .login-left {
        flex: 1;
        background: linear-gradient(145deg, #0f0c29, #302b63, #24243e);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 4rem;
        color: white;
    }

    .brand { margin-bottom: 3rem; }

    .brand-icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 1rem;
    }

    .brand h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        background: linear-gradient(90deg, #a78bfa, #60a5fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .brand p {
        color: rgba(255,255,255,0.6);
        font-size: 1.05rem;
        line-height: 1.6;
        max-width: 320px;
    }

    .features { display: flex; flex-direction: column; gap: 1rem; }

    .feature-item {
        color: rgba(255,255,255,0.75);
        font-size: 0.95rem;
    }

    .login-right {
        width: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f7ff;
        padding: 2rem;
    }

    .login-card { width: 100%; max-width: 380px; }

    .login-header { text-align: center; margin-bottom: 2rem; }

    .login-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }

    .login-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1e1b4b;
        margin-bottom: 0.35rem;
    }

    .login-header p { color: #6b7280; font-size: 0.95rem; }

    .alert {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.875rem 1rem;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        font-size: 0.875rem;
    }

    .alert-error {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-close {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        padding: 0;
        font-size: 1rem;
        opacity: 0.6;
        flex-shrink: 0;
    }

    .alert-close:hover { opacity: 1; }

    .form-group { margin-bottom: 1.25rem; }

    .form-group label {
        display: block;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        margin-bottom: 0.4rem;
    }

    .input-wrapper { position: relative; display: flex; align-items: center; }

    .password-toggle {
        position: absolute;
        right: 0.85rem;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        color: #6b7280;
        padding: 0;
    }

        .password-toggle:hover {
            color: #4f46e5;
        }

    .input-icon {
        position: absolute;
        left: 0.85rem;
        font-size: 1rem;
        pointer-events: none;
    }

    .form-input {
        width: 100%;
        padding: 0.75rem 2.75rem 0.75rem 2.75rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        font-size: 0.95rem;
        color: #111827;
        background: white;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

    .form-input:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
    }

    .form-input:disabled {
        background: #f9fafb;
        opacity: 0.7;
        cursor: not-allowed;
    }

    .btn-login {
        width: 100%;
        padding: 0.875rem;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        font-size: 1rem;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 15px rgba(79,70,229,0.35);
    }

    .btn-login:hover:not(:disabled) {
        opacity: 0.93;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(79,70,229,0.45);
    }

    .btn-login:disabled { opacity: 0.65; cursor: not-allowed; }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
        flex-shrink: 0;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
        font-size: 0.875rem;
        color: #374151;
    }

        .remember-me input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .remember-me label {
            cursor: pointer;
            margin: 0;
        }

    @@keyframes spin { to { transform: rotate(360deg); } }

    @@media (max-width: 768px) {
        .login-page { flex-direction: column; }
        .login-left { padding: 2.5rem 2rem; flex: none; }
        .login-right { width: 100%; padding: 2rem 1.25rem; }
    }
</style>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/tickets");
            return;
        }

        var savedEmail = await JSRuntime.InvokeAsync<string>(
            "localStorage.getItem",
            "rememberEmail");

        if (!string.IsNullOrEmpty(savedEmail))
        {
            email = savedEmail;
            rememberMe = true;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }

    private async Task HandleLogin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your email and password.";
            return;
        }

        isLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("API");
            var loginData = new { Email = email, Password = password };
            var response = await client.PostAsJsonAsync("api/auth/login", loginData);
            var responseBody = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    var errorObj = JsonDocument.Parse(responseBody);
                    errorMessage = errorObj.RootElement
                        .GetProperty("message")
                        .GetString() ?? "Login failed.";
                }
                catch
                {
                    errorMessage = $"Login failed ({(int)response.StatusCode}).";
                }
                return;
            }

            var result = JsonDocument.Parse(responseBody).RootElement;
            var token = result.GetProperty("token").GetString() ?? "";
            var userEl = result.GetProperty("user");

            var roles = userEl.GetProperty("roles")
                .EnumerateArray()
                .Select(r => r.GetString() ?? "")
                .ToList();

            var permissions = userEl.GetProperty("permissions")
                .EnumerateArray()
                .Select(p => p.GetString() ?? "")
                .ToList();

            var user = new LoginUserInfo
            {
                Id = userEl.GetProperty("id").GetInt32(),
                Email = userEl.GetProperty("email").GetString() ?? "",
                FirstName = userEl.GetProperty("firstName").GetString() ?? "",
                LastName = userEl.GetProperty("lastName").GetString() ?? "",
                Roles = roles,
                Permissions = permissions
            };

            await AuthService.Login(token, user);

            if (rememberMe)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "rememberEmail", email);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "rememberEmail");
            }

            Navigation.NavigateTo("/tickets");
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
