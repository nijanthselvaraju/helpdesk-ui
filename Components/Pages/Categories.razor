@page "/categories"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory Http
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using TicketingSystem.UI.Services

<AppShell>
    <ChildContent>
        <div class="content-header">
            <div>
                <h1 class="content-title">Categories</h1>
                <p class="content-subtitle">Manage ticket categories, approval workflows and entity assignments</p>
            </div>
            <button class="btn-create" @onclick="OpenCreateModal">➕ New Category</button>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">Loading categories...</div>
        }
        else if (categories.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🗂️</div>
                <h5>No categories yet</h5>
                <p>Create one to start auto-assigning tickets</p>
            </div>
        }
        else
        {
            <div class="cat-table">
                <div class="table-header">
                    <div>Category</div>
                    <div>Default Assignee</div>
                    <div>Approval</div>
                    <div>Entities</div>
                    <div>Tickets</div>
                    <div>Status</div>
                    <div>Actions</div>
                </div>
                @foreach (var c in categories)
                {
                    <div class="table-row">
                        <div>
                            <strong>@c.Name</strong>
                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <div class="cat-desc">@c.Description</div>
                            }
                        </div>
                        <div class="assignee-chip">
                            <span class="chip-avatar">@GetInitials(c.AssignedUserName)</span>
                            <div>
                                <div class="chip-name">@c.AssignedUserName</div>
                                <div class="chip-email">@c.AssignedUserEmail</div>
                            </div>
                        </div>
                        <div>
                            <span class="approval-badge approval-@c.ApprovalType.ToLower().Replace(" ", "")">
                                @(c.ApprovalType == "NoApproval" ? "None" :
                                  c.ApprovalType == "BeforeWork" ? "Pre-Approval" : "Post-Approval")
                            </span>
                        </div>
                        <div>
                            @if (c.EntityAssignments != null && c.EntityAssignments.Count > 0)
                            {
                                <span class="entity-count" @onclick="() => OpenAssignmentModal(c)" title="Manage entity assignments">
                                    @c.EntityAssignments.Count(a => a.IsActive) active
                                </span>
                            }
                            else
                            {
                                <button class="btn-add-entity" @onclick="() => OpenAssignmentModal(c)">+ Add</button>
                            }
                        </div>
                        <div><span class="count-badge">@c.TicketCount</span></div>
                        <div>
                            <span class="status-dot @(c.IsActive ? "dot-active" : "dot-inactive")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="row-actions">
                            <button class="btn-action btn-edit" @onclick="() => OpenEditModal(c)" title="Edit">✏️</button>
                            <button class="btn-action btn-delete" @onclick="() => DeleteCategory(c.Id)" title="Delete">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</AppShell>

@* ── Create / Edit Category Modal ─────────────────────────────────── *@
@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@(isEditing ? "✏️ Edit Category" : "➕ New Category")</h5>
                <button class="modal-close" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Category Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Network Issue"
                           value="@form.Name"
                           @oninput="e => form.Name = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Default Assignee <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="form.AssignedUserId">
                        <option value="0">-- Select technician --</option>
                        @foreach (var u in allUsers)
                        {
                            <option value="@u.Id">@u.FirstName @u.LastName (@u.Email)</option>
                        }
                    </select>
                    <small class="text-muted">Fallback if no entity-specific assignment exists.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Approval Type</label>
                    <select class="form-select" @bind="form.ApprovalType">
                        <option value="NoApproval">No Approval</option>
                        <option value="BeforeWork">Before Work (Pre-Approval)</option>
                        <option value="AfterWork">After Work (Post-Approval)</option>
                    </select>
                </div>
                @if (form.ApprovalType != "NoApproval")
                {
                    <div class="mb-3">
                        <label class="form-label">Default Approver</label>
                        <select class="form-select" @bind="form.ApproverId">
                            <option value="0">-- Select approver --</option>
                            @foreach (var u in allUsers)
                            {
                                <option value="@u.Id">@u.FirstName @u.LastName (@u.Email)</option>
                            }
                        </select>
                        <small class="text-muted">Fallback if no entity-specific approver set.</small>
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <div class="toggle-row">
                        <span>Active</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="form.IsActive" />
                            <span class="toggle-slider"></span>
                        </label>
                        <span class="text-muted" style="font-size:0.8rem">
                            @(form.IsActive ? "Visible to all entities" : "Hidden from all entities")
                        </span>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveCategory">
                        @(isEditing ? "Update" : "Create")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Entity Assignment Modal ───────────────────────────────────────── *@
@if (showAssignmentModal && selectedCategory != null)
{
    <div class="modal-backdrop" @onclick="CloseAssignmentModal">
        <div class="modal-box modal-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>🏢 Entity Assignments — @selectedCategory.Name</h5>
                <button class="modal-close" @onclick="CloseAssignmentModal">✕</button>
            </div>
            <div class="modal-body">
                <p class="text-muted" style="font-size:0.85rem;margin-bottom:1rem;">
                    Configure which technician handles this category per entity, and who approves it.
                    Overrides the default assignee for users in that entity.
                </p>

                @* Existing assignments *@
                @if (selectedCategory.EntityAssignments?.Count > 0)
                {
                    <div class="assignment-list">
                        @foreach (var a in selectedCategory.EntityAssignments)
                        {
                            <div class="assignment-row @(!a.IsActive ? "row-inactive" : "")">
                                <div class="assignment-entity">
                                    <span class="entity-badge">🏢</span>
                                    <strong>@a.EntityName</strong>
                                </div>
                                <div class="assignment-tech">
                                    <span class="chip-avatar small">@GetInitials(a.AssignedUserName)</span>
                                    <span>@a.AssignedUserName</span>
                                </div>
                                <div class="assignment-approver">
                                    @if (!string.IsNullOrEmpty(a.ApproverName))
                                    {
                                        <span class="chip-avatar small approver">@GetInitials(a.ApproverName)</span>
                                        <span>@a.ApproverName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:0.8rem">No approver</span>
                                    }
                                </div>
                                <div>
                                    <span class="status-dot @(a.IsActive ? "dot-active" : "dot-inactive")">
                                        @(a.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <div class="row-actions">
                                    <button class="btn-action btn-edit" @onclick="() => EditAssignment(a)" title="Edit">✏️</button>
                                    <button class="btn-action btn-delete" @onclick="() => DeleteAssignment(a.Id)" title="Remove">🗑️</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Add / Edit assignment form *@
                <div class="add-assignment-form">
                    <h6>@(editingAssignmentId.HasValue ? "Edit Assignment" : "Add Entity Assignment")</h6>
                    <div class="assignment-form-grid">
                        <div>
                            <label class="form-label">Entity <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="assignmentForm.EntityId" disabled="@editingAssignmentId.HasValue">
                                <option value="0">-- Select entity --</option>
                                @foreach (var e in allEntities)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Technician <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="assignmentForm.AssignedUserId">
                                <option value="0">-- Select technician --</option>
                                @foreach (var u in allUsers)
                                {
                                    <option value="@u.Id">@u.FirstName @u.LastName</option>
                                }
                            </select>
                        </div>
                        @if (selectedCategory.ApprovalType != "NoApproval")
                        {
                            <div>
                                <label class="form-label">Approver</label>
                                <select class="form-select" @bind="assignmentForm.ApproverId">
                                    <option value="0">-- Use category default --</option>
                                    @foreach (var u in allUsers)
                                    {
                                        <option value="@u.Id">@u.FirstName @u.LastName</option>
                                    }
                                </select>
                            </div>
                        }
                        <div>
                            <label class="form-label">Auto-close (days)</label>
                            <input type="number" class="form-control" min="0" max="90"
                                   @bind="assignmentForm.AutoCloseAfterDays"
                                   placeholder="0 = disabled" />
                            <small class="text-muted">Days before auto-close if no approval action taken (0 = off)</small>
                        </div>
                    </div>
                    <div class="toggle-row" style="margin:0.75rem 0">
                        <span>Active</span>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="assignmentForm.IsActive" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="d-flex gap-2">
                        @if (editingAssignmentId.HasValue)
                        {
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEditAssignment">Cancel</button>
                            <button class="btn btn-primary btn-sm" @onclick="SaveAssignment">Update Assignment</button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="SaveAssignment">➕ Add Assignment</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-box toast-@toastType">@toastMessage</div>
}

<style>
