@page "/categories"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory Http
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using TicketingSystem.UI.Services

<AppShell>
    <ChildContent>
        <div class="content-header">
            <div>
                <h1 class="content-title">Categories</h1>
                <p class="content-subtitle">Manage ticket categories and their default assignee</p>
            </div>
            <button class="btn-create" @onclick="OpenCreateModal">➕ New Category</button>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">Loading categories...</div>
        }
        else if (categories.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🗂️</div>
                <h5>No categories yet</h5>
                <p>Create one to start auto-assigning tickets</p>
            </div>
        }
        else
        {
            <div class="cat-table">
                <div class="table-header">
                    <div>Category</div>
                    <div>Assigned To</div>
                    <div>Tickets</div>
                    <div>Actions</div>
                </div>
                @foreach (var c in categories)
                {
                    <div class="table-row">
                        <div>
                            <strong>@c.Name</strong>
                            @if (!string.IsNullOrEmpty(c.Description))
                            { <div class="cat-desc">@c.Description</div> }
                        </div>
                        <div class="assignee-chip">
                            <span class="chip-avatar">@GetInitials(c.AssignedUserName)</span>
                            <div>
                                <div class="chip-name">@c.AssignedUserName</div>
                                <div class="chip-email">@c.AssignedUserEmail</div>
                            </div>
                        </div>
                        <div><span class="count-badge">@c.TicketCount</span></div>
                        <div class="row-actions">
                            <button class="btn-action btn-edit" @onclick="() => OpenEditModal(c)">✏️</button>
                            <button class="btn-action btn-delete" @onclick="() => DeleteCategory(c.Id)">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</AppShell>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@(isEditing ? "✏️ Edit Category" : "➕ New Category")</h5>
                <button class="modal-close" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Category Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Network Issue"
                           value="@form.Name"
                           @oninput="e => form.Name = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Assign To <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="form.AssignedUserId">
                        <option value="0">-- Select user --</option>
                        @foreach (var u in allUsers)
                        {
                            <option value="@u.Id">@u.FirstName @u.LastName (@u.Email)</option>
                        }
                    </select>
                    <small class="text-muted">Tickets auto-assign to this person.</small>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveCategory">
                        @(isEditing ? "Update" : "Create")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showToast)
{
    <div class="toast-box toast-@toastType">@toastMessage</div>
}

<style>
    .content-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .content-title { font-size: 1.5rem; font-weight: 700; color: #1e1b4b; margin: 0; }
    .content-subtitle { color: #6b7280; font-size: 0.875rem; margin: 0; }
    .btn-create {
        background: linear-gradient(135deg, #059669, #10b981);
        color: white; border: none; padding: 0.65rem 1.25rem; border-radius: 10px;
        font-weight: 600; cursor: pointer; font-size: 0.9rem;
    }
    .loading-state, .empty-state { text-align: center; padding: 4rem 2rem; color: #6b7280; }
    .empty-icon { font-size: 3rem; margin-bottom: 1rem; }

    .cat-table { background: white; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); overflow: hidden; }
    .table-header {
        display: grid; grid-template-columns: 2fr 2fr 1fr 1fr;
        padding: 0.75rem 1.25rem; background: #f8f7ff; font-size: 0.78rem; font-weight: 700;
        color: #6b7280; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid #e5e7eb;
    }
    .table-row {
        display: grid; grid-template-columns: 2fr 2fr 1fr 1fr;
        padding: 0.9rem 1.25rem; border-bottom: 1px solid #f3f4f6; align-items: center;
    }
    .table-row:last-child { border-bottom: none; }
    .table-row:hover { background: #fafafa; }
    .cat-desc { font-size: 0.8rem; color: #9ca3af; margin-top: 0.2rem; }

    .assignee-chip { display: flex; align-items: center; gap: 0.5rem; }
    .chip-avatar {
        width: 32px; height: 32px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        color: white; font-weight: 700; font-size: 0.75rem; flex-shrink: 0;
    }
    .chip-name { font-size: 0.875rem; font-weight: 600; color: #1f2937; }
    .chip-email { font-size: 0.75rem; color: #9ca3af; }

    .count-badge {
        background: #ede9fe; color: #5b21b6;
        font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.8rem;
    }

    .row-actions { display: flex; gap: 0.4rem; }
    .btn-action {
        width: 32px; height: 32px; border: none; border-radius: 8px; cursor: pointer;
        font-size: 0.9rem; display: flex; align-items: center; justify-content: center;
    }
    .btn-edit { background: #eff6ff; } .btn-edit:hover { background: #dbeafe; }
    .btn-delete { background: #fef2f2; } .btn-delete:hover { background: #fee2e2; }

    .modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 2000;
        display: flex; align-items: center; justify-content: center; padding: 1rem;
    }
    .modal-box { background: white; border-radius: 16px; width: 100%; max-width: 480px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid #e5e7eb; }
    .modal-header h5 { margin: 0; font-weight: 700; color: #1e1b4b; }
    .modal-close { background: none; border: none; font-size: 1.1rem; cursor: pointer; color: #6b7280; width: 32px; height: 32px; border-radius: 8px; }
    .modal-close:hover { background: #f3f4f6; }
    .modal-body { padding: 1.5rem; }

    .toast-box {
        position: fixed; bottom: 1.5rem; right: 1.5rem; padding: 0.875rem 1.5rem; border-radius: 10px;
        font-weight: 600; font-size: 0.9rem; z-index: 9999; box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .toast-success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .toast-error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
</style>

@code {
    List<CategoryDto> categories = new();
    List<UserDto> allUsers = new();
    bool isLoading = true, showModal = false, isEditing = false;
    bool showToast = false;
    string toastMessage = "", toastType = "";
    CategoryForm form = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        if (!AuthService.HasPermission("CanManageCategories")) { Navigation.NavigateTo("/tickets"); return; }
        await LoadCategories();
        await LoadUsers();
    }

    async Task LoadCategories()
    {
        isLoading = true;
        var client = Http.CreateClient("API");
        categories = await client.GetFromJsonAsync<List<CategoryDto>>("api/category") ?? new();
        isLoading = false;
    }

    async Task LoadUsers()
    {
        var client = Http.CreateClient("API");
        allUsers = await client.GetFromJsonAsync<List<UserDto>>("api/users") ?? new();
    }

    void OpenCreateModal() { isEditing = false; form = new(); showModal = true; }
    void OpenEditModal(CategoryDto c)
    {
        isEditing = true;
        form = new() { Id = c.Id, Name = c.Name, Description = c.Description, AssignedUserId = c.AssignedUserId };
        showModal = true;
    }
    void CloseModal() => showModal = false;

    async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(form.Name) || form.AssignedUserId == 0)
        { ShowToast("Please fill name and assignee", "error"); return; }

        var client = Http.CreateClient("API");
        var dto = new { form.Name, form.Description, form.AssignedUserId };
        var response = isEditing
            ? await client.PutAsJsonAsync($"api/category/{form.Id}", dto)
            : await client.PostAsJsonAsync("api/category", dto);

        if (response.IsSuccessStatusCode)
        { ShowToast(isEditing ? "Category updated" : "Category created", "success"); CloseModal(); await LoadCategories(); }
        else ShowToast("Failed to save category", "error");
    }

    async Task DeleteCategory(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this category?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var response = await client.DeleteAsync($"api/category/{id}");
        if (response.IsSuccessStatusCode) { ShowToast("Deleted", "success"); await LoadCategories(); }
        else ShowToast("Cannot delete — category has tickets", "error");
    }

    string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : name[0].ToString().ToUpper();
    }

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    public class CategoryDto { public int Id { get; set; } public string Name { get; set; } = ""; public string? Description { get; set; } public int AssignedUserId { get; set; } public string? AssignedUserName { get; set; } public string? AssignedUserEmail { get; set; } public int TicketCount { get; set; } }
    public class UserDto { public int Id { get; set; } public string FirstName { get; set; } = ""; public string LastName { get; set; } = ""; public string Email { get; set; } = ""; }
    public class CategoryForm { public int Id { get; set; } public string Name { get; set; } = ""; public string? Description { get; set; } public int AssignedUserId { get; set; } }
}
