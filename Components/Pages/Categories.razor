    .toast-success {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .toast-error {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }
</style>

@code {
    List<CategoryDto> categories = new();
    List<UserDto> allUsers = new();
    List<EntityDto> allEntities = new();
    bool isLoading = true, showModal = false, isEditing = false;
    bool showAssignmentModal = false;
    bool showToast = false;
    string toastMessage = "", toastType = "";
    CategoryForm form = new();
    CategoryDto? selectedCategory;
    AssignmentForm assignmentForm = new();
    int? editingAssignmentId = null;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        if (!AuthService.HasPermission("CanManageCategories")) { Navigation.NavigateTo("/tickets"); return; }
        await Task.WhenAll(LoadCategories(), LoadUsers(), LoadEntities());
    }

    async Task LoadCategories()
    {
        isLoading = true;
        var client = Http.CreateClient("API");
        categories = await client.GetFromJsonAsync<List<CategoryDto>>("api/category") ?? new();
        isLoading = false;
    }

    async Task LoadUsers()
    {
        var client = Http.CreateClient("API");
        allUsers = await client.GetFromJsonAsync<List<UserDto>>("api/users") ?? new();
    }

    async Task LoadEntities()
    {
        var client = Http.CreateClient("API");
        allEntities = await client.GetFromJsonAsync<List<EntityDto>>("api/entity") ?? new();
    }

    void OpenCreateModal() { isEditing = false; form = new() { IsActive = true, ApprovalType = "NoApproval" }; showModal = true; }

    void OpenEditModal(CategoryDto c)
    {
        isEditing = true;
        form = new()
        {
            Id = c.Id,
            Name = c.Name,
            Description = c.Description,
            AssignedUserId = c.AssignedUserId,
            ApproverId = c.ApproverId ?? 0,
            ApprovalType = c.ApprovalType,
            IsActive = c.IsActive
        };
        showModal = true;
    }

    void CloseModal() => showModal = false;

    void OpenAssignmentModal(CategoryDto c)
    {
        selectedCategory = c;
        assignmentForm = new() { IsActive = true };
        editingAssignmentId = null;
        showAssignmentModal = true;
    }

    void CloseAssignmentModal() { showAssignmentModal = false; selectedCategory = null; }

    void EditAssignment(AssignmentDto a)
    {
        editingAssignmentId = a.Id;
        assignmentForm = new()
        {
            EntityId = a.EntityId,
            AssignedUserId = a.AssignedUserId,
            ApproverId = a.ApproverId ?? 0,
            IsActive = a.IsActive,
            AutoCloseAfterDays = a.AutoCloseAfterDays
        };
    }

    void CancelEditAssignment() { editingAssignmentId = null; assignmentForm = new() { IsActive = true }; }

    async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(form.Name) || form.AssignedUserId == 0)
        { ShowToast("Please fill name and default assignee", "error"); return; }

        var client = Http.CreateClient("API");
        var dto = new
        {
            form.Name,
            form.Description,
            form.AssignedUserId,
            ApproverId = form.ApproverId == 0 ? (int?)null : form.ApproverId,
            form.ApprovalType,
            form.IsActive
        };
        var response = isEditing
            ? await client.PutAsJsonAsync($"api/category/{form.Id}", dto)
            : await client.PostAsJsonAsync("api/category", dto);

        if (response.IsSuccessStatusCode)
        { ShowToast(isEditing ? "Category updated" : "Category created", "success"); CloseModal(); await LoadCategories(); }
        else ShowToast("Failed to save category", "error");
    }

    async Task SaveAssignment()
    {
        if (assignmentForm.EntityId == 0 || assignmentForm.AssignedUserId == 0)
        { ShowToast("Select entity and technician", "error"); return; }
        if (selectedCategory == null) return;

        var client = Http.CreateClient("API");
        var dto = new
        {
            assignmentForm.EntityId,
            assignmentForm.AssignedUserId,
            ApproverId = assignmentForm.ApproverId == 0 ? (int?)null : assignmentForm.ApproverId,
            assignmentForm.IsActive,
            assignmentForm.AutoCloseAfterDays
        };

        System.Net.Http.HttpResponseMessage response;
        if (editingAssignmentId.HasValue)
            response = await client.PutAsJsonAsync($"api/category/assignments/{editingAssignmentId.Value}", dto);
        else
            response = await client.PostAsJsonAsync($"api/category/{selectedCategory.Id}/assignments", dto);

        if (response.IsSuccessStatusCode)
        {
            ShowToast(editingAssignmentId.HasValue ? "Assignment updated" : "Assignment added", "success");
            CancelEditAssignment();
            await LoadCategories();
            // Refresh selected category
            selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategory!.Id);
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            ShowToast("Failed: " + err, "error");
        }
    }

    async Task DeleteAssignment(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Remove this entity assignment?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var response = await client.DeleteAsync($"api/category/assignments/{id}");
        if (response.IsSuccessStatusCode)
        {
            ShowToast("Assignment removed", "success");
            await LoadCategories();
            if (selectedCategory != null)
                selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategory.Id);
        }
        else ShowToast("Failed to remove assignment", "error");
    }

    async Task DeleteCategory(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete this category?");
        if (!confirmed) return;
        var client = Http.CreateClient("API");
        var response = await client.DeleteAsync($"api/category/{id}");
        if (response.IsSuccessStatusCode) { ShowToast("Deleted", "success"); await LoadCategories(); }
        else ShowToast("Cannot delete — category has tickets. Deactivate it instead.", "error");
    }

    string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : name[0].ToString().ToUpper();
    }

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

