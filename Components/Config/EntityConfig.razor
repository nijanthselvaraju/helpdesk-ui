@code {
    List<EntityDto> allEntities = new();
    bool isLoading = true, showModal = false, isEditing = false, isSaving = false, showToast = false;
    string toastMessage = "", toastType = "", modalError = "";
    string formName = "", formEntityType = "", formEntityCode = "";
    bool formIsActive = true;
    int editingId = 0;

    int pageNumber = 1;
    int pageSize = 50;
    int[] pageSizeOptions = { 50, 100, 200 };

    int totalItems => allEntities.Count;
    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));
    IEnumerable<EntityDto> PagedEntities => allEntities.Skip((pageNumber - 1) * pageSize).Take(pageSize);

    // Settings
    bool showSettingsMenu = false;
    void ToggleSettingsMenu() => showSettingsMenu = !showSettingsMenu;

    // Entity Types
    List<EntityTypeItem> entityTypes = new();
    bool showEntityTypeModal = false;
    bool etLoading = false;
    string newEntityTypeName = "";
    string etError = "";
    int etEditingId = 0;
    string etEditName = "";

    async Task OpenEntityTypeModal()
    {
        showSettingsMenu = false;
        showEntityTypeModal = true;
        etError = "";
        await LoadEntityTypes();
    }

    void CloseEntityTypeModal() { showEntityTypeModal = false; etError = ""; newEntityTypeName = ""; CancelEntityTypeEdit(); }

    async Task LoadEntityTypes()
    {
        etLoading = true;
        etError = "";
        try
        {
            var result = await Http.CreateClient("API").GetFromJsonAsync<List<EntityTypeItem>>("api/entitytype");
            entityTypes = result ?? new();
        }
        catch (Exception ex)
        {
            etError = "Failed to load entity types: " + ex.Message;
            entityTypes = new();
        }
        finally { etLoading = false; }
    }

    async Task AddEntityType()
    {
        var name = newEntityTypeName.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        etError = "";
        try
        {
            var response = await Http.CreateClient("API").PostAsJsonAsync("api/entitytype", new { Name = name });
            if (response.IsSuccessStatusCode)
            {
                newEntityTypeName = "";
                await LoadEntityTypes();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                try { etError = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? "Failed to add."; }
                catch { etError = $"Failed to add. Status: {(int)response.StatusCode}"; }
            }
        }
        catch (Exception ex) { etError = "Error: " + ex.Message; }
    }

    void StartEntityTypeEdit(EntityTypeItem et) { etEditingId = et.Id; etEditName = et.Name; etError = ""; }
    void CancelEntityTypeEdit() { etEditingId = 0; etEditName = ""; }

    async Task SaveEntityTypeEdit()
    {
        var name = etEditName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { etError = "Name cannot be empty."; return; }
        etError = "";
        try
        {
            var response = await Http.CreateClient("API").PutAsJsonAsync($"api/entitytype/{etEditingId}", new { Name = name });
            if (response.IsSuccessStatusCode) { CancelEntityTypeEdit(); await LoadEntityTypes(); }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                try { etError = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? "Failed to update."; }
                catch { etError = $"Failed to update. Status: {(int)response.StatusCode}"; }
            }
        }
        catch (Exception ex) { etError = "Error: " + ex.Message; }
    }

    async Task ToggleEntityTypeStatus(EntityTypeItem et)
    {
        try
        {
            var content = new StringContent(
                System.Text.Json.JsonSerializer.Serialize(new { IsActive = !et.IsActive }),
                System.Text.Encoding.UTF8, "application/json");
            var response = await Http.CreateClient("API").PatchAsync($"api/entitytype/{et.Id}/status", content);
            if (response.IsSuccessStatusCode) await LoadEntityTypes();
            else ShowToast("Failed to update status", "error");
        }
        catch (Exception ex) { ShowToast("Error: " + ex.Message, "error"); }
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        if (!AuthService.IsSuperAdmin() && !AuthService.HasRole("Admin"))
        { Navigation.NavigateTo("/tickets"); return; }
        await Task.WhenAll(LoadEntities(), LoadEntityTypes());
    }

    async Task LoadEntities()
    {
        isLoading = true;
        try
        {
            var client = Http.CreateClient("API");
            var result = await client.GetFromJsonAsync<List<EntityDto>>("api/entity");
            allEntities = result ?? new();
        }
        catch (Exception ex) { allEntities = new(); ShowToast("Failed to load entities: " + ex.Message, "error"); }
        finally { isLoading = false; }
    }

    void SetPageSize(int size) { pageSize = size; pageNumber = 1; }
    void FirstPage() => pageNumber = 1;
    void PrevPage() { if (pageNumber > 1) pageNumber--; }
    void NextPage() { if (pageNumber < TotalPages) pageNumber++; }
    void LastPage() => pageNumber = TotalPages;

    async Task ExportData(string format)
    {
        var headers = new[] { "#", "Entity Type", "Entity Name", "Entity Code", "Status", "Created At" };
        var rows = allEntities.Select((e, i) => new[]
        {
            (i + 1).ToString(), e.EntityType, e.Name, e.EntityCode,
            e.IsActive ? "Active" : "Inactive",
            e.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
        }).ToList();

        if (format == "csv")
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(string.Join(",", headers.Select(h => $"\"{h}\"")));
            foreach (var row in rows)
                sb.AppendLine(string.Join(",", row.Select(c => $"\"{c}\"")));
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            await JS.InvokeVoidAsync("eval",
                $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{base64}';a.download='entities.csv';a.click();}})()");
        }
        else
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(string.Join("\t", headers));
            foreach (var row in rows)
                sb.AppendLine(string.Join("\t", row));
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            await JS.InvokeVoidAsync("eval",
                $"(function(){{var a=document.createElement('a');a.href='data:application/vnd.ms-excel;base64,{base64}';a.download='entities.xls';a.click();}})()");
        }
        ShowToast($"Exported as {format.ToUpper()}", "success");
    }

    void OpenAddModal()
    {
        isEditing = false; editingId = 0;
        formEntityType = ""; formName = ""; formEntityCode = "";
        formIsActive = true; modalError = ""; showModal = true;
    }

    void OpenEditModal(EntityDto e)
    {
        isEditing = true; editingId = e.Id;
        formEntityType = e.EntityType; formName = e.Name;
        formEntityCode = e.EntityCode; formIsActive = e.IsActive;
        modalError = ""; showModal = true;
    }

    void CloseModal() { showModal = false; modalError = ""; }

    async Task SaveEntity()
    {
        modalError = "";
        if (string.IsNullOrWhiteSpace(formEntityType)) { modalError = "Entity Type is required."; return; }
        if (string.IsNullOrWhiteSpace(formName)) { modalError = "Entity Name is required."; return; }
        if (string.IsNullOrWhiteSpace(formEntityCode)) { modalError = "Entity Code is required."; return; }

        isSaving = true;
        try
        {
            var client = Http.CreateClient("API");
            var dto = new { EntityType = formEntityType.Trim(), Name = formName.Trim(), EntityCode = formEntityCode.Trim().ToUpper(), IsActive = formIsActive };
            HttpResponseMessage response;
            if (isEditing)
                response = await client.PutAsJsonAsync($"api/entity/{editingId}", dto);
            else
                response = await client.PostAsJsonAsync("api/entity", dto);

            if (response.IsSuccessStatusCode)
            {
                ShowToast(isEditing ? "Entity updated" : "Entity added", "success");
                CloseModal();
                await LoadEntities();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                string msg = "Failed to save entity";
                try { msg = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString() ?? msg; }
                catch { }
                modalError = msg;
            }
        }
        catch (Exception ex) { modalError = "Error: " + ex.Message; }
        finally { isSaving = false; }
    }

    async Task DeleteEntity(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this entity? This cannot be undone.");
        if (!confirmed) return;
        var response = await Http.CreateClient("API").DeleteAsync($"api/entity/{id}");
        if (response.IsSuccessStatusCode) { ShowToast("Entity deleted", "success"); await LoadEntities(); }
        else ShowToast("Failed to delete entity", "error");
    }

    void ShowToast(string msg, string type)
    {
        toastMessage = msg; toastType = type; showToast = true; StateHasChanged();
        _ = Task.Run(async () => { await Task.Delay(3000); showToast = false; await InvokeAsync(StateHasChanged); });
    }

    public class EntityDto
    {
        public int Id { get; set; }
        public string EntityType { get; set; } = "";
        public string Name { get; set; } = "";
        public string EntityCode { get; set; } = "";
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class EntityTypeItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
}
