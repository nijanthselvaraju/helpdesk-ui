@inject AuthService AuthService
@inject NavigationManager Navigation
@inject SidebarStateService SidebarState
@inject AssetService AssetService
@implements IDisposable
@using TicketingSystem.UI.Services

<div class="app-shell">
    <!-- Top Navbar -->
    <div class="top-navbar">
        <div class="top-navbar-left">
            <button class="sidebar-toggle" @onclick="TogglePin" title="Pin/unpin sidebar">
                ☰
            </button>
            @if (!string.IsNullOrEmpty(AssetService.LogoUrl))
            {
                <img src="@(apiBase + AssetService.LogoUrl)" alt="Logo" class="app-logo" />
            }
            else
            {
                <span class="app-brand">🎫 Helpdesk Ticket</span>
            }
        </div>

        <div class="top-filters">
            @TopBarContent
        </div>

        <div class="top-navbar-right">
            <div class="profile-section">
                <div class="profile-avatar">@GetInitials()</div>
                <div class="profile-info">
                    <span class="profile-name">@AuthService.CurrentUser.Name</span>
                    <span class="profile-email">@AuthService.CurrentUser.Email</span>
                </div>
                <button class="btn-logout" @onclick="HandleLogout">🚪</button>
            </div>
        </div>
    </div>

    <!-- Page Layout -->
    <div class="page-layout">
        <!-- Sidebar -->
        <div class="sidebar @(SidebarState.IsExpanded ? "sidebar-expanded" : "sidebar-collapsed")"
             @onmouseenter="HandleSidebarHover"
             @onmouseleave="HandleSidebarLeave">
            <div class="sidebar-content">
                <div class="sidebar-header">
                    @if (SidebarState.IsExpanded)
                    {
                        <span class="sidebar-header-label">Navigation</span>
                    }
                    <button class="pin-btn @(SidebarState.IsPinned ? "pinned" : "")"
                            @onclick="TogglePin"
                            title="@(SidebarState.IsPinned ? "Unpin sidebar" : "Pin sidebar")">
                        📌
                    </button>
                </div>
                <nav class="sidebar-nav">
                    <a href="/tickets" class="nav-item @(IsActive("/tickets") ? "active" : "")" title="Tickets">
                        <span class="nav-icon">🎫</span>
                        @if (SidebarState.IsExpanded)
                        {
                            <span class="nav-label">Tickets</span>
                        }
                    </a>
                    @if (AuthService.HasPermission("CanManageCategories"))
                    {
                        <a href="/categories" class="nav-item @(IsActive("/categories") ? "active" : "")" title="Categories">
                            <span class="nav-icon">🗂️</span>
                            @if (SidebarState.IsExpanded)
                            {
                                <span class="nav-label">Categories</span>
                            }
                        </a>
                    }
                    @if (AuthService.HasPermission("CanManageUsers"))
                    {
                        <a href="/users" class="nav-item @(IsActive("/users") ? "active" : "")" title="Users">
                            <span class="nav-icon">👥</span>
                            @if (SidebarState.IsExpanded)
                            {
                                <span class="nav-label">Users</span>
                            }
                        </a>
                    }
                    @if (AuthService.IsSuperAdmin() || AuthService.HasRole("Admin"))
                    {
                        <a href="/roles" class="nav-item @(IsActive("/roles") ? "active" : "")" title="Roles & Permissions">
                            <span class="nav-icon">🔐</span>
                            @if (SidebarState.IsExpanded)
                            {
                                <span class="nav-label">Roles &amp; Permissions</span>
                            }
                        </a>
                    }
                    @if (AuthService.IsSuperAdmin() || AuthService.HasRole("Admin"))
                    {
                        <a href="/config/assets" class="nav-item @(IsActive("/config") ? "active" : "")" title="Config">
                            <span class="nav-icon">🛠️</span>
                            @if (SidebarState.IsExpanded)
                            {
                                <span class="nav-label">Config</span>
                            }
                        </a>
                    }
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content @(SidebarState.IsPinned ? "content-shifted" : "content-collapsed")">
            @ChildContent
        </div>
    </div>
</div>

<style>
    * { box-sizing: border-box; }
    :root {
        --sidebar-width: 220px;
        --sidebar-collapsed-width: 64px;
    }

    .app-shell { min-height: 100vh; }

    .top-navbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 60px;
        background: linear-gradient(135deg, #1e1b4b, #312e81);
        display: flex;
        align-items: center;
        padding: 0 1.25rem;
        gap: 1rem;
        z-index: 1000;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .top-navbar-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 180px;
    }

    .sidebar-toggle {
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        font-size: 1.25rem;
        width: 36px; height: 36px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
        flex-shrink: 0;
    }
    .sidebar-toggle:hover { background: rgba(255,255,255,0.2); }

    .app-brand { color: white; font-weight: 700; font-size: 1rem; white-space: nowrap; }
    .app-logo { height: 40px; max-width: 160px; object-fit: contain; }

    .top-filters {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .top-navbar-right { margin-left: auto; flex-shrink: 0; }

    .profile-section { display: flex; align-items: center; gap: 0.6rem; }

    .profile-avatar {
        width: 36px; height: 36px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: white; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;
    }

    .profile-info { display: flex; flex-direction: column; }
    .profile-name { color: white; font-size: 0.85rem; font-weight: 600; line-height: 1.2; white-space: nowrap; }
    .profile-email { color: rgba(255,255,255,0.55); font-size: 0.75rem; line-height: 1.2; white-space: nowrap; }

    .btn-logout {
        background: rgba(255,255,255,0.1);
        border: none; color: white;
        width: 34px; height: 34px;
        border-radius: 8px; cursor: pointer; font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s; flex-shrink: 0;
    }
    .btn-logout:hover { background: rgba(239,68,68,0.4); }

    .page-layout {
        display: flex;
        margin-top: 60px;
        min-height: calc(100vh - 60px);
    }

    /* Sidebar */
    .sidebar {
        position: fixed;
        top: 60px; left: 0; bottom: 0;
        width: var(--sidebar-collapsed-width);
        background: linear-gradient(180deg, #1e1b4b 0%, #312e81 100%);
        transition: width 0.2s ease;
        z-index: 900;
        overflow: hidden;
    }

    .sidebar-expanded { width: var(--sidebar-width); }
    .sidebar-collapsed { width: var(--sidebar-collapsed-width); }

    .sidebar-content { padding: 0.75rem 0; height: 100%; }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 0.85rem 0.75rem;
        color: rgba(255,255,255,0.5);
        font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 0.5rem;
        min-height: 20px;
    }

    .sidebar-header-label { white-space: nowrap; }

    .pin-btn {
        background: none; border: none; cursor: pointer;
        font-size: 0.9rem; opacity: 0.4;
        transition: opacity 0.2s, transform 0.2s;
        padding: 0; flex-shrink: 0; margin-left: auto;
    }
    .pin-btn:hover { opacity: 0.8; }
    .pin-btn.pinned { opacity: 1; transform: rotate(-45deg); }

    .sidebar-nav { display: flex; flex-direction: column; }

    .nav-item {
        display: flex; align-items: center; gap: 0.85rem;
        padding: 0.7rem 0.85rem;
        color: rgba(255,255,255,0.7);
        text-decoration: none; font-size: 0.9rem;
        transition: all 0.15s;
        border-left: 3px solid transparent;
        white-space: nowrap;
    }
    .nav-icon { font-size: 1.1rem; flex-shrink: 0; width: 22px; text-align: center; }
    .nav-label { flex: 1; }

    .nav-item:hover { background: rgba(255,255,255,0.08); color: white; }
    .nav-item.active { background: rgba(255,255,255,0.12); color: white; border-left-color: #a78bfa; }

    /* Main Content */
    .main-content {
        flex: 1; padding: 1.75rem;
        transition: margin-left 0.2s ease;
        min-width: 0; background: #f8f7ff;
    }
    .content-shifted { margin-left: var(--sidebar-width); }
    .content-collapsed { margin-left: var(--sidebar-collapsed-width); }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? TopBarContent { get; set; }

    string apiBase = "http://localhost:5027";

    protected override async Task OnInitializedAsync()
    {
        await AssetService.LoadAssetsAsync();
    }

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        SidebarState.OnStateChanged += OnStateChanged;
        AssetService.OnAssetsChanged += OnStateChanged;
    }

    void OnStateChanged() => InvokeAsync(StateHasChanged);
    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return ("/" + relative).StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    void HandleSidebarHover() => SidebarState.SetExpanded(true);
    void HandleSidebarLeave() => SidebarState.SetExpanded(false);

    void TogglePin()
    {
        SidebarState.SetPinned(!SidebarState.IsPinned);
    }

    string GetInitials()
    {
        var name = AuthService.CurrentUser.Name;
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[0].ToString().ToUpper();
    }

    async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        SidebarState.OnStateChanged -= OnStateChanged;
        AssetService.OnAssetsChanged -= OnStateChanged;
    }
}
